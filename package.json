{
  "name": "blih-system",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=blih-system-backend",
    "start:api": "npm run start --workspace blih-system-backend",
    "lint": "turbo run lint",
    "lint:api": "npm run lint:check --workspace blih-system-backend",
    "check-types": "turbo run check-types",
    "typecheck:api": "npm run typecheck --workspace blih-system-backend",
    "test:api": "npm run test --workspace blih-system-backend",
    "api:verify": "npm run lint:check --workspace blih-system-backend && npm run typecheck --workspace blih-system-backend && npm run test --workspace blih-system-backend -- --ci --passWithNoTests",
    "branch:check": "node apps/api/scripts/git/validate-branch-name.js",
    "commits:check": "commitlint --from HEAD~1 --to HEAD --verbose",
    "commits:check:branch": "commitlint --from main --to HEAD --verbose",
    "docker:api:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "docker:api:down": "docker compose -f apps/api/docker-compose.yml down",
    "docker:api:infra:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "docker:api:infra:down": "docker compose -f apps/api/docker-compose.yml down",
    "docker:api:infra:status": "docker compose -f apps/api/docker-compose.yml ps",
    "docker:api:infra:logs": "docker compose -f apps/api/docker-compose.yml logs -f",
    "docker:api:infra:reset": "docker compose -f apps/api/docker-compose.yml down -v && docker compose -f apps/api/docker-compose.yml up -d",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "clean": "npm run clean:node_modules && npm run clean:cache",
    "clean:node_modules": "rimraf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:cache": "rimraf .turbo && npm cache clean --force",
    "install:clean": "npm run clean && npm install --workspaces --include-workspace-root",
    "validate:lockfile": "npm ls --workspaces --depth=0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
