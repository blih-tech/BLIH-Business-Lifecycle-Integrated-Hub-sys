{
  "name": "blih-system",
  "private": true,
  "scripts": {

    "build": "turbo run build",
    "dev": "concurrently -k --kill-signal SIGINT --kill-timeout 2000 --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace blih-system-backend",
    "dev:web": "npm run dev --workspace web",
    "start:api": "npm run start --workspace blih-system-backend",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --ci --passWithNoTests",
    "verify": "npm run lint && npm run check-types",
    "verify:full": "npm run lint && npm run check-types && npm run test:ci",
    "lint:api": "npm run lint:check --workspace blih-system-backend",
    "check-types": "turbo run check-types --concurrency=1",
    "typecheck:api": "npm run typecheck --workspace blih-system-backend",
    "test:api": "npm run test --workspace blih-system-backend",
    "api:verify": "npm run lint:check --workspace blih-system-backend && npm run typecheck --workspace blih-system-backend && npm run test --workspace blih-system-backend -- --ci --passWithNoTests",

    "db:check-ports": "bash ./scripts/check-ports.sh",
    "db:health": "bash ./scripts/db-local.sh health",
    "vps:info": "bash ./scripts/get-vps-info.sh",
    "vps:backup": "bash ./scripts/db-local.sh backup blih-system-dev && bash ./scripts/db-local.sh backup keycloak",

    "docker:api:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "docker:api:down": "docker compose -f apps/api/docker-compose.yml down",
    "docker:api:infra:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "docker:api:infra:down": "docker compose -f apps/api/docker-compose.yml down",
    "docker:api:infra:status": "docker compose -f apps/api/docker-compose.yml ps",
    "docker:api:infra:logs": "docker compose -f apps/api/docker-compose.yml logs -f",
    "docker:api:infra:reset": "docker compose -f apps/api/docker-compose.yml down -v && docker compose -f apps/api/docker-compose.yml up -d",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "clean": "npm run clean:node_modules && npm run clean:cache",
    "clean:node_modules": "rimraf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:cache": "rimraf .turbo && npm cache clean --force",
    "install:clean": "npm run clean && npm install --workspaces --include-workspace-root",
    "validate:lockfile": "npm ls --workspaces --depth=0",
    "commit:quick": "npm run lint && npm run check-types && git add . && git commit -m",
    "db:build": "npm run build --workspace @repo/database",
    "db:prisma:format": "npm run prisma:format --workspace @repo/database",
    "db:prisma:generate": "npm run prisma:generate --workspace @repo/database",
    "db:prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @repo/database",
    "db:prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @repo/database",
    "db:prisma:seed": "npm run prisma:seed --workspace @repo/database",
    "db:prisma:validate": "npm run prisma:validate --workspace @repo/database",
    "db:check-types": "npm run check-types --workspace @repo/database"
  },
  "devDependencies": {

    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.33",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "concurrently": "^9.2.1",

    "postgres": "^3.4.8",
    "prettier": "^3.7.4",
    "retry": "^0.13.1",
    "rimraf": "^6.0.1",
    "std-env": "^4.0.0-rc.1",
    "turbo": "^2.8.10",
    "typescript": "5.9.2",
    "zeptomatch": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "next": "15.1.12",
    "pdf-parse-debugging-disabled": "^1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
