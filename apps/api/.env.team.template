# =============================================================================
# BLIH System - Team Member Environment Configuration
# =============================================================================
# This template is for team members developing on their local machines
# while connecting to the shared VPS database.
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace <VPS_HOST> with your actual VPS hostname or IP
#    Example: dev.blih.com or 192.168.1.100
# 3. Verify you can connect to the VPS before starting development
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# =============================================================================
# Database Configuration (Shared VPS Database)
# =============================================================================
# Replace <VPS_HOST> with your VPS hostname/IP
DATABASE_URL=postgresql://blih_dev_user:blih_dev_pass_2024@<VPS_HOST>:5432/blih-system-dev
SKIP_DATABASE_CONNECT=false

# =============================================================================
# Keycloak Authentication & Authorization (Shared VPS Service)
# =============================================================================
KEYCLOAK_ENABLED=true
# Replace <VPS_HOST> with your VPS hostname/IP
KEYCLOAK_URL=http://<VPS_HOST>:8080
KEYCLOAK_REALM=blih
KEYCLOAK_CLIENT_ID=blih-system-api
KEYCLOAK_CLIENT_SECRET=my-blih-dev-secret-2024
KEYCLOAK_AUTH_CLIENT_ID=blih-system-auth
KEYCLOAK_AUTH_CLIENT_SECRET=replace-with-auth-client-secret
KEYCLOAK_AUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/callback
KEYCLOAK_AUTH_SCOPES=openid profile email

# Admin CLI for Keycloak Admin API
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Security settings
TRUST_PROXY_PRINCIPAL_HEADERS=false
INTERNAL_AUTH_SHARED_SECRET=change-me-before-enabling-trusted-headers
ENFORCE_MFA_FOR_PRIVILEGED=false
AUTH_POLICY_VERSION=1.0
AUTH_LOGIN_ERROR_REDIRECT_URI=/login
AUTH_POST_LOGIN_REDIRECT_URI=/
AUTH_POST_LOGOUT_REDIRECT_URI=/login
AUTH_STATE_TTL_SECONDS=600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# JWT Configuration - Replace <VPS_HOST> with your VPS hostname/IP
KEYCLOAK_JWKS_URL=http://<VPS_HOST>:8080/realms/blih/protocol/openid-connect/certs
JWT_EXPECTED_AUDIENCE=blih-system-api
JWT_EXPECTED_ISSUER=http://<VPS_HOST>:8080/realms/blih

# Frontend client
KEYCLOAK_FRONTEND_CLIENT_ID=blih-system-frontend
KEYCLOAK_FRONTEND_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak

# =============================================================================
# Message Broker (Optional)
# =============================================================================
RABBITMQ_ENABLED=false
# Replace <VPS_HOST> with your VPS hostname/IP if enabling a broker
RABBITMQ_URL=amqp://blih_user:blih_pass_2024@<VPS_HOST>:5672/blih
RABBITMQ_EXCHANGE=blih.events
RABBITMQ_DLQ=system.dlq
EVENT_CONTRACT_VERSION=1.0
EVENT_SCHEMA_PREFIX=blih.event
EVENT_SUPPORTED_MAJOR_VERSION=1
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000

# =============================================================================
# Email Configuration (Shared VPS MailHog)
# =============================================================================
SMTP_ENABLED=true
# Replace <VPS_HOST> with your VPS hostname/IP
SMTP_HOST=<VPS_HOST>
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=noreply@blih.local
SMTP_PASSWORD=changeme
EMAIL_FROM=BLIH System <noreply@blih.local>

# =============================================================================
# Security & Rate Limiting
# =============================================================================
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# =============================================================================
# Audit & Logging Configuration
# =============================================================================
AUDIT_RETENTION_DAYS=2555
PRINCIPAL_CONTEXT_TTL_MS=30000
SYNC_ROLES_FROM_KEYCLOAK=false
LOG_LEVEL=debug
LOG_FORMAT=json

# =============================================================================
# Background Jobs Configuration
# =============================================================================
SYNC_USERS_CRON=0 */30 * * * *
SYNC_ROLES_CRON=0 0 */2 * * *
ROTATE_SECRETS_CRON=0 0 1 * *
CLEANUP_AUDIT_CRON=0 0 2 * *

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=5000

# =============================================================================
# WebSocket Configuration
# =============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001
WEBSOCKET_PATH=/socket.io

# =============================================================================
# Development & Debugging
# =============================================================================
DEBUG=true
LOG_REQUESTS=true
PERFORMANCE_MONITORING=true

# =============================================================================
# Database Connection Pool Settings
# =============================================================================
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=300000
KEYCLOAK_TIMEOUT_MS=10000
RABBITMQ_TIMEOUT_MS=10000

# =============================================================================
# Feature Flags
# =============================================================================
MULTI_REALM_ENABLED=true
ORGANIZATION_HIERARCHY_ENABLED=true
ADVANCED_RBAC_ENABLED=true
AUDIT_EXPORT_ENABLED=true
NOTIFICATION_BATCHING_ENABLED=true

