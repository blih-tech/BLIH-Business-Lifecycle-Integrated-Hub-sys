# =============================================================================
# BLIH System Core - Environment Configuration
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://postgres:admin1234@localhost:5432/blih-system
SKIP_DATABASE_CONNECT=false

# =============================================================================
# Keycloak Authentication & Authorization
# =============================================================================
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=blih
# Must match the confidential client in Keycloak (e.g. blih-system-api in realm-export)
KEYCLOAK_CLIENT_ID=blih-system-api
# Secret for the client above; get from Keycloak Client → Credentials or realm-export
KEYCLOAK_CLIENT_SECRET=my-blih-dev-secret-2024

# Admin CLI — used by your backend to call Keycloak Admin API (create users, assign roles, etc.)
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

TRUST_PROXY_PRINCIPAL_HEADERS=false
INTERNAL_AUTH_SHARED_SECRET=change-me-before-enabling-trusted-headers
# Set false for local/dev so privileged roles (e.g. superadmin) can call /auth/me without MFA; set true in production
ENFORCE_MFA_FOR_PRIVILEGED=false
AUTH_POLICY_VERSION=1.0

# ⚠️ FIXED: JWKS URL must match your realm name "blih"
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/blih/protocol/openid-connect/certs

# Frontend client
KEYCLOAK_FRONTEND_CLIENT_ID=blih-system-frontend
KEYCLOAK_FRONTEND_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak

# ⚠️ FIXED: JWT audience should match your audience mapper client ID
JWT_EXPECTED_AUDIENCE=blih-system-api
# ⚠️ FIXED: JWT issuer must match your realm
JWT_EXPECTED_ISSUER=http://keycloak:8080/realms/blih

# -----------------------------------------------------------------------------
# Docker Keycloak container (only if running Keycloak via Docker)
# -----------------------------------------------------------------------------
# KEYCLOAK_PORT=127.0.0.1:8080
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=noreply@blih.local
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM=BLIH System <noreply@blih.local>

# =============================================================================
# Security & Rate Limiting
# =============================================================================
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# =============================================================================
# Audit & Logging Configuration
# =============================================================================
AUDIT_RETENTION_DAYS=2555
PRINCIPAL_CONTEXT_TTL_MS=30000
SYNC_ROLES_FROM_KEYCLOAK=false
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Background Jobs Configuration
# =============================================================================
SYNC_USERS_CRON=0 */30 * * * *
SYNC_ROLES_CRON=0 0 */2 * * *
ROTATE_SECRETS_CRON=0 0 1 * *
CLEANUP_AUDIT_CRON=0 0 2 * *

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=5000

# =============================================================================
# WebSocket Configuration
# =============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001
WEBSOCKET_PATH=/socket.io

# =============================================================================
# Development & Debugging
# =============================================================================
DEBUG=false
LOG_REQUESTS=true
PERFORMANCE_MONITORING=true
