  status              DisciplinaryStatus       @default(PENDING)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([incidentType])
  @@index([status])
  @@index([effectiveFrom])
