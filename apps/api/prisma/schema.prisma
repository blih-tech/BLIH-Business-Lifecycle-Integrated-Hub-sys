  salaryMax           Decimal?          @map("salary_max") @db.Decimal(12, 2)
  salaryCurrency      String?           @map("salary_currency") @db.VarChar(8)
  salaryMode          JobSalaryMode     @default(NOT_SPECIFIED) @map("salary_mode")
