// Employee Relations (HR Implementation Plan 07)
enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentType {
  SAFETY
  SECURITY
  CONFLICT
  HARASSMENT
  OTHER
}

enum IncidentReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum DisciplinaryIncidentType {
  ATTENDANCE_VIOLATION
  PERFORMANCE_ISSUE
  CODE_OF_CONDUCT
}

enum DisciplinaryActionType {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  PERFORMANCE_IMPROVEMENT_PLAN
  SUSPENSION
  TERMINATION
}

enum DisciplinaryStatus {
  PENDING
  ACTIVE
  EXPIRED
  APPEALED
}

enum GrievanceStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum RecognitionCategory {
  EXCELLENCE
  TEAMWORK
  INNOVATION
  SERVICE
  OTHER
}

enum RecognitionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SurveyType {
  SATISFACTION
  PULSE
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum MediationStatus {
  PENDING
  IN_PROGRESS
  AGREEMENT_REACHED
  CLOSED
}

model IncidentReport {
  id                 String               @id @default(uuid()) @db.Uuid
  reportId           String               @unique @map("report_id") @db.VarChar(32)
  employeeId         String               @map("employee_id") @db.Uuid
  employee           Employee             @relation("IncidentReportReporter", fields: [employeeId], references: [id], onDelete: Restrict)
  incidentType       IncidentType         @map("incident_type")
  severity           IncidentSeverity
  description        String               @db.Text
  location           String?              @db.VarChar(256)
  occurredAt         DateTime             @map("occurred_at")
  peopleInvolved     Json?                @map("people_involved") @db.JsonB
  immediateActions   Json?                @map("immediate_actions") @db.JsonB
  investigatorId     String?              @map("investigator_id") @db.Uuid
  investigator       User?                @relation("IncidentReportInvestigator", fields: [investigatorId], references: [id], onDelete: SetNull)
  slaHours           Int?                 @map("sla_hours")
  investigationDueAt DateTime?            @map("investigation_due_at")
  investigationNotes String?              @map("investigation_notes") @db.Text
  rootCause          String?              @map("root_cause") @db.Text
  preventiveActions  Json?                @map("preventive_actions") @db.JsonB
  status             IncidentReportStatus @default(OPEN)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@index([severity])
  @@index([investigatorId])
}

model DisciplinaryAction {
  id               String                   @id @default(uuid()) @db.Uuid
  employeeId       String                   @map("employee_id") @db.Uuid
  employee         Employee                 @relation("DisciplinaryActionSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  incidentType     DisciplinaryIncidentType @map("incident_type")
  actionType       DisciplinaryActionType   @map("action_type")
  incidentReportId String?                  @map("incident_report_id") @db.Uuid
  description      String                   @db.Text
  effectiveFrom    DateTime                 @map("effective_from") @db.Date
  expiresAt        DateTime?                @map("expires_at") @db.Date
  durationDays     Int?                     @map("duration_days")
  approvedById     String?                  @map("approved_by_id") @db.Uuid
  approvedBy       User?                    @relation("DisciplinaryActionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  status           DisciplinaryStatus       @default(PENDING)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([incidentType])
  @@index([status])
  @@index([effectiveFrom])
}

model Grievance {
  id              String          @id @default(uuid()) @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  employee        Employee        @relation("GrievanceReporter", fields: [employeeId], references: [id], onDelete: Restrict)
  subject         String          @db.VarChar(512)
  description     String          @db.Text
  category        String?         @db.VarChar(128)
