generator client {
  provider     = "prisma-client"
  output       = "../src/platform/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  ANNUAL
}

enum LifecycleStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum DocumentType {
  CONTRACT
  ID
  CERTIFICATE
  MEDICAL
  RESUME
  POLICY_ACK
  QUALIFICATION
  OTHER
}

enum ContractType {
  INITIAL
  RENEWAL
  AMENDMENT
  ADDENDUM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

// Recruitment (HR Implementation Plan 02)
enum RecruitmentRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RecruitmentRequestType {
  NEW
  REPLACEMENT
}

enum JobPostingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  FILLED
  EXPIRED
  CANCELLED
}

enum CandidateStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW_STAGE
  OFFER_PENDING
  HIRED
  REJECTED
  WITHDRAWN
}

enum CandidateSource {
  COMPANY_SITE
  LINKEDIN
  TELEGRAM
  REFERRAL
  AGENCY
}

enum ScreeningRecommendation {
  SELECT
  PAUSE
  DECLINE
}

enum InterviewType {
  HR_SCREENING
  TECHNICAL
  BEHAVIORAL
  PANEL
  FINAL
}

enum EndorsementLevel {
  STRONG_YES
  YES
  UNCERTAIN
  NO
}

enum HiringDecisionOutcome {
  OFFER_APPROVED
  OFFER_DECLINED
  SUSPENDED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Onboarding subsystem (HR Implementation Plan 03)
enum OnboardingChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum OnboardingTaskDepartment {
  HR
  IT
  ADMIN
  TEAM
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ProbationPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProbationEvaluationRound {
  DAY_30
  DAY_55
  DAY_60_FINAL
}

enum ProbationRecommendation {
  CONFIRM
  EXTEND
  TERMINATE
}

enum ProbationConfirmationVerdict {
  CONFIRM
  EXTEND
  TERMINATE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                           String                    @id @default(uuid()) @db.Uuid
  keycloakId                   String                    @unique
  username                     String                    @unique
  email                        String                    @unique
  firstName                    String
  lastName                     String
  phone                        String?
  status                       UserStatus                @default(ACTIVE)
  lastLoginAt                  DateTime?
  metadata                     Json?
  permissions                  String[]                  @default([])
  profile                      UserProfile?
  employment                   UserEmployment?
  compensation                 UserCompensation?
  compensationHistory          UserCompensationHistory[]
  employmentChanges            UserEmploymentHistory[]   @relation("EmploymentChangedBy")
  compensationChanges          UserCompensationHistory[] @relation("CompensationChangedBy")
  lifecycle                    UserLifecycle?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  roles                        UserRole[]
  employeeDocuments            EmployeeDocument[]
  verifiedDocuments            EmployeeDocument[]        @relation("EmployeeDocumentVerifiedBy")
  contracts                    Contract[]
  submittedRecruitmentRequests RecruitmentRequest[]      @relation("RecruitmentRequestSubmittedBy")
  referredCandidates           Candidate[]               @relation("CandidateReferral")
  screeningDecisions           CvScreening[]             @relation("CvScreeningScreenedBy")
  compiledInterviewFeedback    InterviewFeedback[]       @relation("InterviewFeedbackCompiledBy")
  submittedHiringDecisions     HiringDecision[]          @relation("HiringDecisionSubmittedBy")
  replacementRequests          RecruitmentRequest[]      @relation("RecruitmentRequestReplacementFor")
  hiringDecisionsAsEmployee    HiringDecision[]          @relation("HiringDecisionEmployee")
  givenRecruitmentApprovals    RecruitmentApproval[]     @relation("RecruitmentApprovalApprover")
  onboardings                  Onboarding[]              @relation("OnboardingUser")
  onboardingChecklists        OnboardingChecklist[]     @relation("OnboardingChecklistUser")
  checklistsOverseen         OnboardingChecklist[]     @relation("OnboardingChecklistOverseer")
  assignedOnboardingTasks    OnboardingTask[]          @relation("OnboardingTaskAssignee")
  completedOnboardingTasks   OnboardingTask[]          @relation("OnboardingTaskCompletedBy")
  assetProvisionings           AssetProvisioning[]
  policyAcknowledgements       PolicyAcknowledgement[]
  policyAcknowledgementsVerified PolicyAcknowledgement[] @relation("PolicyAcknowledgementVerifiedBy")
  probationKpiPlans            ProbationKpiPlan[]        @relation("ProbationKpiPlanUser")
  probationEvaluations         ProbationEvaluation[]     @relation("ProbationEvaluationUser")
  probationConfirmations      ProbationConfirmation[]

  @@index([status])
}

model Department {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String                  @unique
  description         String?
  parentId            String?                 @map("parent_id") @db.Uuid
  parent              Department?             @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Department[]            @relation("DepartmentHierarchy")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  positions           Position[]
  employmentHistory   UserEmploymentHistory[]
  recruitmentRequests RecruitmentRequest[]

  @@index([parentId])
}

model Position {
  id                  String                  @id @default(uuid()) @db.Uuid
  title               String
  description         String?
  departmentId        String                  @db.Uuid
  department          Department              @relation(fields: [departmentId], references: [id])
  headcountLimit      Int?                    @map("headcount_limit")
  employments         UserEmployment[]
  jobDescriptions     JobDescription[]
  employmentHistory   UserEmploymentHistory[]
  recruitmentRequests RecruitmentRequest[]
  jobPostings         JobPosting[]
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([departmentId, title])
  @@index([departmentId])
  @@index([isActive])
}

model CountryReference {
  id                  String        @id @default(uuid()) @db.Uuid
  code                String?       @unique @db.VarChar(3)
  name                String        @unique
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  nationalityProfiles UserProfile[] @relation("ProfileNationality")
  residenceProfiles   UserProfile[] @relation("ProfileResidenceCountry")

  @@index([isActive])
}

model UserProfile {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @db.Uuid
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  gender                Gender?
  nationalityId         String?           @db.Uuid
  nationality           CountryReference? @relation("ProfileNationality", fields: [nationalityId], references: [id], onDelete: SetNull)
  maritalStatus         MaritalStatus?
  avatarUrl             String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  countryId             String?           @db.Uuid
  country               CountryReference? @relation("ProfileResidenceCountry", fields: [countryId], references: [id], onDelete: SetNull)
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([nationalityId])
  @@index([countryId])
}

model UserEmployment {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @unique @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode           String?                 @unique
  positionId             String?                 @db.Uuid
  position               Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType         EmploymentType          @default(FULL_TIME)
  managerEmploymentId    String?                 @db.Uuid
  managerEmployment      UserEmployment?         @relation("EmploymentManagerRelation", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  subordinateEmployments UserEmployment[]        @relation("EmploymentManagerRelation")
  history                UserEmploymentHistory[] @relation("EmploymentHistory")
  managedHistoryEntries  UserEmploymentHistory[] @relation("EmploymentHistoryManagerRelation")
  hiredAt                DateTime?
  probationEndAt         DateTime?
  confirmedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([positionId])
  @@index([managerEmploymentId])
}

model UserEmploymentHistory {
  id                  String          @id @default(uuid()) @db.Uuid
  userEmploymentId    String          @db.Uuid
  userEmployment      UserEmployment  @relation("EmploymentHistory", fields: [userEmploymentId], references: [id], onDelete: Cascade)
  employeeCode        String?
  departmentId        String?         @db.Uuid
  department          Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId          String?         @db.Uuid
  position            Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType      EmploymentType  @default(FULL_TIME)
  managerEmploymentId String?         @db.Uuid
  managerEmployment   UserEmployment? @relation("EmploymentHistoryManagerRelation", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  effectiveFrom       DateTime        @default(now())
  effectiveTo         DateTime?
  changeReason        String?
  changedById         String?         @db.Uuid
  changedBy           User?           @relation("EmploymentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())

  @@index([userEmploymentId])
  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmploymentId])
  @@index([changedById])
  @@index([effectiveFrom])
  @@index([userEmploymentId, effectiveFrom])
}

model UserCompensation {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary    Decimal?     @db.Decimal(15, 2)
  currency      String?
  payFrequency  PayFrequency @default(MONTHLY)
  bonusEligible Boolean      @default(false)
  bonusRate     Decimal?     @db.Decimal(5, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model UserCompensationHistory {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary    Decimal?     @db.Decimal(15, 2)
  currency      String?
  payFrequency  PayFrequency @default(MONTHLY)
  bonusEligible Boolean      @default(false)
  bonusRate     Decimal?     @db.Decimal(5, 2)
  validFrom     DateTime
  validTo       DateTime?
  changeReason  String?
  changedById   String?      @db.Uuid
  changedBy     User?        @relation("CompensationChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([userId, validFrom])
  @@index([userId, validTo])
  @@index([changedById])
}

model UserLifecycle {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @unique @db.Uuid
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               LifecycleStatus @default(ONBOARDING)
  onboardedAt          DateTime?
  suspendedAt          DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  offboardingCompleted Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Role {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  displayName  String
  description  String?
  parentRoleId String?          @db.Uuid
  parentRole   Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   Role[]           @relation("RoleHierarchy")
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([name])
  @@index([parentRoleId])
}

model PermissionResource {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model PermissionAction {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  resourceId  String             @db.Uuid
  actionId    String             @db.Uuid
  resource    PermissionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  action      PermissionAction   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  slug        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  roleLinks   RolePermission[]

  @@unique([resourceId, actionId])
  @@index([resourceId])
  @@index([actionId])
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  assignedBy String?   @db.Uuid
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  action        String
  module        String
  resource      String
  resourceId    String?
  actorUserId   String?
  actorEmail    String?
  requestId     String
  correlationId String
  sessionId     String?
  ipAddress     String
  userAgent     String
  result        AuditResult @default(SUCCESS)
  statusCode    Int?
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
  @@index([actorUserId])
  @@index([action, resource])
}

model AuditExport {
  id          String    @id @default(uuid()) @db.Uuid
  requestedBy String
  format      String
  filters     Json?
  status      String
  filePath    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String?
  type       String
  priority   String
  title      String
  body       String
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  response       Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([notificationId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  url       String
  secret    String?
  enabled   Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ModuleConfig {
  id         String   @id @default(uuid()) @db.Uuid
  module     String   @unique
  enabled    Boolean  @default(true)
  licenseKey String?
  settings   Json?
  updatedAt  DateTime @updatedAt
}

model SecurityPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  requireMfa            Boolean  @default(true)
  maxConcurrentSessions Int      @default(3)
  sessionTimeoutMinutes Int      @default(480)
  passwordMinLength     Int      @default(12)
  lockoutThreshold      Int      @default(5)
  updatedAt             DateTime @updatedAt
}

model EmployeeDocument {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          DocumentType
  typeOther     String?      @map("type_other")
  fileUrl       String       @map("file_url")
  fileName      String?      @map("file_name")
  fileSizeBytes Int?         @map("file_size_bytes")
  mimeType      String?      @map("mime_type")
  issueDate     DateTime?    @map("issue_date") @db.Date
  expiryDate    DateTime?    @map("expiry_date") @db.Date
  isMandatory   Boolean      @default(false) @map("is_mandatory")
  verified      Boolean      @default(false)
  verifiedById  String?      @map("verified_by_id") @db.Uuid
  verifiedBy    User?        @relation("EmployeeDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt    DateTime?    @map("verified_at")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([expiryDate])
  @@index([verifiedById])
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractType    ContractType   @map("contract_type")
  sequenceNumber  Int            @map("sequence_number")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  trialApplies    Boolean        @default(false) @map("trial_applies")
  trialEndDate    DateTime?      @map("trial_end_date") @db.Date
  trialConfirmed  Boolean        @default(false) @map("trial_confirmed")
  documentUrl     String?        @map("document_url")
  status          ContractStatus @default(DRAFT)
  syncedToFinance Boolean        @default(false) @map("synced_to_finance")
  syncedAt        DateTime?      @map("synced_at")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([userId, sequenceNumber])
  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model JobDescription {
  id            String    @id @default(uuid()) @db.Uuid
  positionId    String?   @map("position_id") @db.Uuid
  position      Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  title         String
  level         String?
  code          String?   @unique
  summary       String?   @db.Text
  duties        Json?
  skills        Json?
  kpis          Json?
  documentUrl   String?   @map("document_url")
  version       Int       @default(1)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([positionId])
  @@index([title])
}

// Recruitment (HR Plan 02)
model RecruitmentRequest {
  id                 String                   @id @default(uuid()) @db.Uuid
  requestId          String                   @unique @map("request_id") @db.VarChar(32)
  departmentId       String                   @map("department_id") @db.Uuid
  department         Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId         String?                  @map("position_id") @db.Uuid
  position           Position?                @relation(fields: [positionId], references: [id], onDelete: SetNull)
  type               RecruitmentRequestType   @default(NEW)
  replacementUserId  String?                  @map("replacement_user_id") @db.Uuid
  replacementUser    User?                    @relation("RecruitmentRequestReplacementFor", fields: [replacementUserId], references: [id], onDelete: SetNull)
  rationale          Json?                    @db.JsonB
  staffing           Json?                    @db.JsonB
  schedule           Json?                    @db.JsonB
  submittedById      String                   @map("submitted_by_id") @db.Uuid
  submittedBy        User                     @relation("RecruitmentRequestSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt        DateTime?                @map("submitted_at")
  approvalSteps      RecruitmentApproval[]    @relation("RecruitmentRequestApprovals")
  status             RecruitmentRequestStatus @default(DRAFT)
  linkedJobPostingId String?                  @map("linked_job_posting_id") @db.Uuid
  linkedJobPosting   JobPosting?              @relation("RequestLinkedPosting", fields: [linkedJobPostingId], references: [id], onDelete: SetNull)
  linkedUserId       String?                  @map("linked_user_id") @db.Uuid
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  jobPostings        JobPosting[]             @relation("RequestCreatedPostings")
  hiringDecisions    HiringDecision[]

  @@index([departmentId])
  @@index([status])
  @@index([submittedById])
  @@index([submittedAt])
}

model JobPosting {
  id                   String               @id @default(uuid()) @db.Uuid
  postingId            String               @unique @map("posting_id") @db.VarChar(32)
  recruitmentRequestId String               @map("recruitment_request_id") @db.Uuid
  recruitmentRequest   RecruitmentRequest   @relation("RequestCreatedPostings", fields: [recruitmentRequestId], references: [id], onDelete: Restrict)
  positionId           String?              @map("position_id") @db.Uuid
  position             Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  positionSnapshot     Json?                @map("position_snapshot") @db.JsonB
  description          Json?                @db.JsonB
  prerequisites        Json?                @db.JsonB
  kpis                 Json?                @db.JsonB
  platforms            String[]             @default([])
  status               JobPostingStatus     @default(DRAFT)
  postedAt             DateTime?            @map("posted_at")
  expiresAt            DateTime?            @map("expires_at")
  closedAt             DateTime?            @map("closed_at")
  approvedBy           Json?                @map("approved_by") @db.JsonB
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  candidates           Candidate[]
  cvScreenings         CvScreening[]
  hiringDecisions      HiringDecision[]
  linkedFromRequests   RecruitmentRequest[] @relation("RequestLinkedPosting")

  @@index([recruitmentRequestId])
  @@index([positionId])
  @@index([status])
  @@index([expiresAt])
}

model Candidate {
  id                   String              @id @default(uuid()) @db.Uuid
  candidateId          String              @unique @map("candidate_id") @db.VarChar(32)
  jobPostingId         String              @map("job_posting_id") @db.Uuid
  jobPosting           JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  source               CandidateSource     @default(COMPANY_SITE)
  referralUserId       String?             @map("referral_user_id") @db.Uuid
  referralUser         User?               @relation("CandidateReferral", fields: [referralUserId], references: [id], onDelete: SetNull)
  email                String?             @db.VarChar(255)
  phone                String?             @db.VarChar(64)
  firstName            String?             @map("first_name") @db.VarChar(120)
  lastName             String?             @map("last_name") @db.VarChar(120)
  personalInfo         Json?               @map("personal_info") @db.JsonB
  career               Json?               @db.JsonB
  applicationResponses Json?               @map("application_responses") @db.JsonB
  status               CandidateStatus     @default(NEW)
  pipeline             Json?               @db.JsonB
  rejection            Json?               @db.JsonB
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cvScreenings         CvScreening[]
  interviewFeedback    InterviewFeedback[]
  hiringDecisions      HiringDecision[]

  @@unique([jobPostingId, email])
  @@index([jobPostingId])
  @@index([status])
  @@index([referralUserId])
}

model CvScreening {
  id                 String                   @id @default(uuid()) @db.Uuid
  candidateId        String                   @map("candidate_id") @db.Uuid
  candidate          Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPostingId       String                   @map("job_posting_id") @db.Uuid
  jobPosting         JobPosting               @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  assessments        Json?                    @db.JsonB
  aggregateRating    Decimal?                 @map("aggregate_rating") @db.Decimal(5, 2)
  recommendation     ScreeningRecommendation?
  nextPhase          String?                  @map("next_phase") @db.VarChar(32)
  screenedById       String                   @map("screened_by_id") @db.Uuid
  screenedBy         User                     @relation("CvScreeningScreenedBy", fields: [screenedById], references: [id], onDelete: Restrict)
  screenedAt         DateTime                 @map("screened_at")
  approvedById       String?                  @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?                @map("approved_at")
  interviewScheduled Boolean                  @default(false) @map("interview_scheduled")
  rejectionSent      Boolean                  @default(false) @map("rejection_sent")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([candidateId, jobPostingId])
  @@index([candidateId])
  @@index([jobPostingId])
  @@index([screenedById])
}

model InterviewFeedback {
  id             String            @id @default(uuid()) @db.Uuid
  candidateId    String            @map("candidate_id") @db.Uuid
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewRound Int               @map("interview_round")
  interviewType  InterviewType     @map("interview_type")
  scheduledAt    DateTime?         @map("scheduled_at")
  completedAt    DateTime?         @map("completed_at")
  interviewers   Json?             @db.JsonB
  ratings        Json?             @db.JsonB
  totalRating    Decimal?          @map("total_rating") @db.Decimal(5, 2)
  endorsement    EndorsementLevel?
  remarks        String?           @db.Text
  nextAction     String?           @map("next_action") @db.VarChar(32)
  compiledById   String            @map("compiled_by_id") @db.Uuid
  compiledBy     User              @relation("InterviewFeedbackCompiledBy", fields: [compiledById], references: [id], onDelete: Restrict)
  compiledAt     DateTime          @map("compiled_at")
  ranking        Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([candidateId, interviewRound])
  @@index([candidateId])
  @@index([compiledById])
}

model HiringDecision {
  id                   String                 @id @default(uuid()) @db.Uuid
  decisionId           String                 @unique @map("decision_id") @db.VarChar(32)
  candidateId          String                 @map("candidate_id") @db.Uuid
  candidate            Candidate              @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  recruitmentRequestId String                 @map("recruitment_request_id") @db.Uuid
  recruitmentRequest   RecruitmentRequest     @relation(fields: [recruitmentRequestId], references: [id], onDelete: Restrict)
  jobPostingId         String                 @map("job_posting_id") @db.Uuid
  jobPosting           JobPosting             @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  candidateSummary     Json?                  @map("candidate_summary") @db.JsonB
  offer                Json?                  @db.JsonB
  selectionReasoning   String?                @map("selection_reasoning") @db.Text
  keyAssets            Json?                  @map("key_assets") @db.JsonB
  attachments          Json?                  @db.JsonB
  submittedById        String                 @map("submitted_by_id") @db.Uuid
  submittedBy          User                   @relation("HiringDecisionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt          DateTime?              @map("submitted_at")
  approvals            Json?                  @db.JsonB
  finalDecision        HiringDecisionOutcome? @map("final_decision")
  offerDocumentUrl     String?                @map("offer_document_url")
  candidateNotifiedAt  DateTime?              @map("candidate_notified_at")
  offerAccepted        Boolean                @default(false) @map("offer_accepted")
  acceptedAt           DateTime?              @map("accepted_at")
  offerExpiresAt       DateTime?              @map("offer_expires_at")
  employeeId           String?                @map("employee_id") @db.Uuid
  employee             User?                  @relation("HiringDecisionEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  onboardingId         String?                @map("onboarding_id") @db.Uuid
  onboarding           Onboarding?            @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  onboardingChecklists OnboardingChecklist[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([candidateId])
  @@index([recruitmentRequestId])
  @@index([jobPostingId])
  @@index([submittedById])
  @@index([finalDecision])
}

model Onboarding {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation("OnboardingUser", fields: [userId], references: [id], onDelete: Cascade)
  status          OnboardingStatus @default(PENDING)
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  hiringDecisions HiringDecision[]
  checklists      OnboardingChecklist[]

  @@index([userId])
  @@index([status])
}

model OnboardingChecklist {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  user                User                     @relation("OnboardingChecklistUser", fields: [userId], references: [id], onDelete: Cascade)
  onboardingId        String?                  @map("onboarding_id") @db.Uuid
  onboarding          Onboarding?              @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  hiringDecisionId    String?                  @map("hiring_decision_id") @db.Uuid
  hiringDecision      HiringDecision?          @relation(fields: [hiringDecisionId], references: [id], onDelete: SetNull)
