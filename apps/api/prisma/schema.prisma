generator client {
  provider     = "prisma-client"
  output       = "../src/platform/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  ANNUAL
}

enum LifecycleStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ON_LEAVE
  TERMINATED
  RESIGNED
  RETIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum DocumentType {
  CONTRACT
  ID
  CERTIFICATE
  MEDICAL
  RESUME
  POLICY_ACK
  QUALIFICATION
  OTHER
}

enum ContractType {
  INITIAL
  RENEWAL
  AMENDMENT
  ADDENDUM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

// Recruitment (HR Implementation Plan 02)
enum RecruitmentRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RecruitmentRequestType {
  NEW
  REPLACEMENT
}

enum JobPostingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  FILLED
  EXPIRED
  CANCELLED
}

enum CandidateStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW_STAGE
  OFFER_PENDING
  HIRED
  REJECTED
  WITHDRAWN
}

enum CandidateSource {
  COMPANY_SITE
  LINKEDIN
  TELEGRAM
  REFERRAL
  AGENCY
}

enum ScreeningRecommendation {
  SELECT
  PAUSE
  DECLINE
}

enum InterviewType {
  HR_SCREENING
  TECHNICAL
  BEHAVIORAL
  PANEL
  FINAL
}

enum EndorsementLevel {
  STRONG_YES
  YES
  UNCERTAIN
  NO
}

enum HiringDecisionOutcome {
  OFFER_APPROVED
  OFFER_DECLINED
  SUSPENDED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Onboarding subsystem (HR Implementation Plan 03)
enum OnboardingChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum OnboardingTaskDepartment {
  HR
  IT
  ADMIN
  TEAM
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ProbationPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProbationEvaluationRound {
  DAY_30
  DAY_55
  DAY_60_FINAL
}

enum ProbationRecommendation {
  CONFIRM
  EXTEND
  TERMINATE
}

enum ProbationConfirmationVerdict {
  CONFIRM
  EXTEND
  TERMINATE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// Attendance & Leave (HR Implementation Plan 04)
enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  STUDY
  EMERGENCY
  COMPASSIONATE
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  ON_LEAVE
  HALF_DAY
  REMOTE
  BUSINESS_TRIP
}

// Performance & OKR (HR Implementation Plan 05)
enum ReviewPeriodType {
  QUARTERLY
  ANNUAL
}

enum ReviewStatus {
  NOT_STARTED
  SELF_PENDING
  SELF_SUBMITTED
  MANAGER_PENDING
  MANAGER_SUBMITTED
  COMPLETED
}

enum PerformanceCategory {
  UNSATISFACTORY
  BELOW_EXPECTATIONS
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING
}

enum PerformanceFeedbackRole {
  SELF
  MANAGER
  PEER
  SKIP_LEVEL
  DIRECT_REPORT
}

enum OkrStatus {
  DRAFT
  ACTIVE
  AT_RISK
  DELAYED
  ACHIEVED
  PARTIALLY_ACHIEVED
  MISSED
  COMPLETED
}

enum KeyResultType {
  NUMERIC
  PERCENTAGE
  BOOLEAN
  MILESTONE
}

enum KeyResultStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  DELAYED
  ACHIEVED
}

enum OkrScope {
  COMPANY
  DEPARTMENT
  USER
}

enum CompensationComponentType {
  ALLOWANCE
  BONUS
  DEDUCTION
  BENEFIT
}

enum SuccessionReadiness {
  READY_NOW
  ONE_YEAR
  TWO_YEARS
}

enum SuccessionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PromotionProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AssetProvisioningStatus {
  PENDING
  APPROVED
  PROVISIONED
  REJECTED
  COMPLETED
}

enum ProbationFinalDecision {
  CONFIRM
  EXTEND
  TERMINATE
}

// Training (HR Implementation Plan 06)
enum TrainingRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TrainingType {
  SKILL
  COMPLIANCE
  LEADERSHIP
  OTHER
}

enum CompletionStatus {
  COMPLETED
  PARTIAL
  DROPPED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillSource {
  SELF
  MANAGER
  ASSESSMENT
  TRAINING
}

enum CostPayer {
  COMPANY
  SELF
}

model User {
  id                               String                      @id @default(uuid()) @db.Uuid
  keycloakId                       String                      @unique
  username                         String                      @unique
  email                            String                      @unique
  firstName                        String
  lastName                         String
  phone                            String?
  status                           UserStatus                  @default(ACTIVE)
  lastLoginAt                      DateTime?
  metadata                         Json?
  permissions                      String[]                    @default([])
  employee                         Employee?
  employmentChanges                UserEmploymentHistory[]     @relation("EmploymentChangedBy")
  compensationChanges              UserCompensationHistory[]   @relation("CompensationChangedBy")
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt
  roles                            UserRole[]
  verifiedDocuments                EmployeeDocument[]          @relation("EmployeeDocumentVerifiedBy")
  submittedRecruitmentRequests     RecruitmentRequest[]        @relation("RecruitmentRequestSubmittedBy")
  referredCandidates               Candidate[]                 @relation("CandidateReferral")
  screeningDecisions               CvScreening[]               @relation("CvScreeningScreenedBy")
  compiledInterviewFeedback        InterviewFeedback[]         @relation("InterviewFeedbackCompiledBy")
  submittedHiringDecisions         HiringDecision[]            @relation("HiringDecisionSubmittedBy")
  givenRecruitmentApprovals        RecruitmentApproval[]       @relation("RecruitmentApprovalApprover")
  checklistsOverseen               OnboardingChecklist[]       @relation("OnboardingChecklistOverseer")
  assignedOnboardingTasks          OnboardingTask[]            @relation("OnboardingTaskAssignee")
  completedOnboardingTasks         OnboardingTask[]            @relation("OnboardingTaskCompletedBy")
  policyAcknowledgementsVerified   PolicyAcknowledgement[]     @relation("PolicyAcknowledgementVerifiedBy")
  delegatedLeaveHandovers          LeaveRequest[]              @relation("LeaveRequestHandoverDelegate")
  leaveRequestsApproved            LeaveRequest[]              @relation("LeaveRequestApprover")
  leaveApprovals                   LeaveApproval[]             @relation("LeaveApprovalApprover")
  performanceReviewFeedback        PerformanceReviewFeedback[] @relation("PerformanceReviewFeedbackReviewer")
  finalizedPerformanceCalibrations PerformanceCalibration[]    @relation("PerformanceCalibrationFinalizedBy")
  keyResultUpdates                 KeyResultUpdate[]           @relation("KeyResultUpdatedBy")
  proposedPromotions               PromotionProposal[]         @relation("PromotionProposalProposedBy")
  approvedPromotions               PromotionProposal[]         @relation("PromotionProposalApprovedBy")
  approvedTrainingRequests         TrainingRequest[]          @relation("TrainingRequestApprover")
  skillGapAssessmentsCreated       SkillGapAssessment[]        @relation("SkillGapAssessmentAssessor")
  incidentInvestigations           IncidentReport[]            @relation("IncidentReportInvestigator")
  disciplinaryActionsApproved      DisciplinaryAction[]         @relation("DisciplinaryActionApprover")
  grievancesAssigned              Grievance[]                 @relation("GrievanceAssignee")
  recognitionsNominated           Recognition[]               @relation("RecognitionNominator")
  recognitionsApproved            Recognition[]               @relation("RecognitionApprover")
  surveysCreated                  Survey[]                    @relation("SurveyCreator")
  mediationAsMediator             ConflictMediation[]        @relation("MediationMediator")
  resignationsApproved            Resignation[]               @relation("ResignationApprover")
  offboardingTasksAssigned        OffboardingTask[]           @relation("OffboardingTaskAssignee")
  offboardingTasksCompleted       OffboardingTask[]           @relation("OffboardingTaskCompletedBy")
  exitInterviewsConducted         ExitInterview[]             @relation("ExitInterviewConductedBy")
  finalSettlementsApproved        FinalSettlement[]           @relation("FinalSettlementApprover")
  complianceChecklistsVerified    ComplianceChecklist[]       @relation("ComplianceChecklistVerifiedBy")

  @@index([status])
}

model Employee {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String?                   @unique @map("user_id") @db.Uuid
  user                   User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile                UserProfile?
  employment             UserEmployment?
  compensation           UserCompensation?
  compensationHistory    UserCompensationHistory[]
  compensationComponents CompensationComponent[]
  lifecycle              UserLifecycle?
  employeeDocuments      EmployeeDocument[]
  contracts              Contract[]
  hiringDecisions        HiringDecision[]          @relation("HiringDecisionEmployee")
  replacementRecruitmentRequests RecruitmentRequest[] @relation("RecruitmentRequestReplacementFor")
  linkedRecruitmentRequests RecruitmentRequest[]   @relation("RecruitmentRequestLinkedEmployee")
  onboardings            Onboarding[]
  onboardingChecklists   OnboardingChecklist[]
  assetProvisionings     AssetProvisioning[]
  policyAcknowledgements PolicyAcknowledgement[]
  probationKpiPlans      ProbationKpiPlan[]
  probationEvaluations   ProbationEvaluation[]
  probationConfirmations ProbationConfirmation[]
  leaveRequests          LeaveRequest[]
  leaveBalances          LeaveBalance[]
  attendanceLogs         AttendanceLog[]
  workScheduleAssignments UserWorkSchedule[]
  performanceReviews     PerformanceReview[]
  okrs                   Okr[]
  successionPlans        SuccessionPlan[]          @relation("SuccessionCandidateEmployee")
  promotionProposals     PromotionProposal[]       @relation("PromotionProposalEmployee")
  trainingRequests       TrainingRequest[]
  trainingCompletions    TrainingCompletion[]
  employeeSkills         EmployeeSkill[]
  incidentReportsFiled   IncidentReport[]          @relation("IncidentReportReporter")
  disciplinaryActionsSubject DisciplinaryAction[]  @relation("DisciplinaryActionSubject")
  grievancesFiled        Grievance[]               @relation("GrievanceReporter")
  recognitionsReceived   Recognition[]             @relation("RecognitionNominee")
  surveyResponses        SurveyResponse[]
  mediationAsRequester   ConflictMediation[]       @relation("MediationRequester")
  mediationAsOtherParty  ConflictMediation[]       @relation("MediationOtherParty")
  resignations           Resignation[]
  offboardingChecklists  OffboardingChecklist[]
  exitInterviews         ExitInterview[]
  finalSettlements       FinalSettlement[]
  assetReturns           AssetReturn[]
  complianceChecklists   ComplianceChecklist[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([userId])
}

model Department {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @unique
  description             String?
  parentId                String?                  @map("parent_id") @db.Uuid
  parent                  Department?              @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                Department[]             @relation("DepartmentHierarchy")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  positions               Position[]
  employmentHistory       UserEmploymentHistory[]
  recruitmentRequests     RecruitmentRequest[]
  okrs                    Okr[]
  performanceCalibrations PerformanceCalibration[]
  trainingBudgets         TrainingBudget[]
  trainingRequests        TrainingRequest[]
  skillGapAssessments     SkillGapAssessment[]

  @@index([parentId])
}

model JobGrade {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  level     Int
  minSalary Decimal?   @map("min_salary") @db.Decimal(15, 2)
  maxSalary Decimal?   @map("max_salary") @db.Decimal(15, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  positions Position[]

  @@index([level])
}

model Position {
  id                  String                  @id @default(uuid()) @db.Uuid
  title               String
  description         String?
  departmentId        String                  @db.Uuid
  department          Department              @relation(fields: [departmentId], references: [id])
  gradeId             String?                 @map("grade_id") @db.Uuid
  grade               JobGrade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  headcountLimit      Int?                    @map("headcount_limit")
  employments         UserEmployment[]
  jobDescriptions     JobDescription[]
  employmentHistory   UserEmploymentHistory[]
  recruitmentRequests RecruitmentRequest[]
  jobPostings         JobPosting[]
  successionPlans     SuccessionPlan[]
  promotionSourceFor  PromotionProposal[]     @relation("PromotionProposalFromPosition")
  promotionTargetFor  PromotionProposal[]     @relation("PromotionProposalToPosition")
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([departmentId, title])
  @@index([departmentId])
  @@index([gradeId])
  @@index([isActive])
}

model CountryReference {
  id                  String        @id @default(uuid()) @db.Uuid
  code                String?       @unique @db.VarChar(3)
  name                String        @unique
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  nationalityProfiles UserProfile[] @relation("ProfileNationality")
  residenceProfiles   UserProfile[] @relation("ProfileResidenceCountry")
  holidays            Holiday[]

  @@index([isActive])
}

model UserProfile {
  id                    String            @id @default(uuid()) @db.Uuid
  employeeId            String            @unique @map("employee_id") @db.Uuid
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  gender                Gender?
  nationalityId         String?           @db.Uuid
  nationality           CountryReference? @relation("ProfileNationality", fields: [nationalityId], references: [id], onDelete: SetNull)
  maritalStatus         MaritalStatus?
  avatarUrl             String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  countryId             String?           @db.Uuid
  country               CountryReference? @relation("ProfileResidenceCountry", fields: [countryId], references: [id], onDelete: SetNull)
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([nationalityId])
  @@index([countryId])
}

model UserEmployment {
  id                     String                  @id @default(uuid()) @db.Uuid
  employeeId             String                  @unique @map("employee_id") @db.Uuid
  employee               Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeCode           String?                 @unique
  positionId             String?                 @db.Uuid
  position               Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType         EmploymentType          @default(FULL_TIME)
  managerEmploymentId    String?                 @db.Uuid
  managerEmployment      UserEmployment?         @relation("EmploymentManagerRelation", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  subordinateEmployments UserEmployment[]        @relation("EmploymentManagerRelation")
  history                UserEmploymentHistory[] @relation("EmploymentHistory")
  managedHistoryEntries  UserEmploymentHistory[] @relation("EmploymentHistoryManagerRelation")
  hiredAt                DateTime?
  probationEndAt         DateTime?
  confirmedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([positionId])
  @@index([managerEmploymentId])
}

model UserEmploymentHistory {
  id                  String          @id @default(uuid()) @db.Uuid
  userEmploymentId    String          @db.Uuid
  userEmployment      UserEmployment  @relation("EmploymentHistory", fields: [userEmploymentId], references: [id], onDelete: Cascade)
  employeeCode        String?
  departmentId        String?         @db.Uuid
  department          Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId          String?         @db.Uuid
  position            Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType      EmploymentType  @default(FULL_TIME)
  managerEmploymentId String?         @db.Uuid
  managerEmployment   UserEmployment? @relation("EmploymentHistoryManagerRelation", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  effectiveFrom       DateTime        @default(now())
  effectiveTo         DateTime?
  changeReason        String?
  changedById         String?         @db.Uuid
  changedBy           User?           @relation("EmploymentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())

  @@index([userEmploymentId])
  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmploymentId])
  @@index([changedById])
  @@index([effectiveFrom])
  @@index([userEmploymentId, effectiveFrom])
}

model UserCompensation {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @unique @map("employee_id") @db.Uuid
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Decimal?     @db.Decimal(15, 2)
  currency      String?
  payFrequency  PayFrequency @default(MONTHLY)
  bonusEligible Boolean      @default(false)
  bonusRate     Decimal?     @db.Decimal(5, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model UserCompensationHistory {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Decimal?     @db.Decimal(15, 2)
  currency      String?
  payFrequency  PayFrequency @default(MONTHLY)
  bonusEligible Boolean      @default(false)
  bonusRate     Decimal?     @db.Decimal(5, 2)
  validFrom     DateTime
  validTo       DateTime?
  changeReason  String?
  changedById   String?      @db.Uuid
  changedBy     User?        @relation("CompensationChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([employeeId])
  @@index([employeeId, validFrom])
  @@index([employeeId, validTo])
  @@index([changedById])
}

model CompensationComponent {
  id            String                    @id @default(uuid()) @db.Uuid
  employeeId    String                    @map("employee_id") @db.Uuid
  employee      Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name          String
  type          CompensationComponentType
  amount        Decimal                   @db.Decimal(15, 2)
  isRecurring   Boolean                   @default(true) @map("is_recurring")
  effectiveFrom DateTime                  @map("effective_from")
  effectiveTo   DateTime?                 @map("effective_to")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([effectiveFrom])
}

model UserLifecycle {
  id                   String          @id @default(uuid()) @db.Uuid
  employeeId           String          @unique @map("employee_id") @db.Uuid
  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status               LifecycleStatus @default(ONBOARDING)
  onboardedAt          DateTime?
  suspendedAt          DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  offboardingCompleted Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Role {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  displayName  String
  description  String?
  parentRoleId String?          @db.Uuid
  parentRole   Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   Role[]           @relation("RoleHierarchy")
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([name])
  @@index([parentRoleId])
}

model PermissionResource {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model PermissionAction {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  resourceId  String             @db.Uuid
  actionId    String             @db.Uuid
  resource    PermissionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  action      PermissionAction   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  slug        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  roleLinks   RolePermission[]

  @@unique([resourceId, actionId])
  @@index([resourceId])
  @@index([actionId])
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  assignedBy String?   @db.Uuid
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  action        String
  module        String
  resource      String
  resourceId    String?
  actorUserId   String?
  actorEmail    String?
  requestId     String
  correlationId String
  sessionId     String?
  ipAddress     String
  userAgent     String
  result        AuditResult @default(SUCCESS)
  statusCode    Int?
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
  @@index([actorUserId])
  @@index([action, resource])
}

model AuditExport {
  id          String    @id @default(uuid()) @db.Uuid
  requestedBy String
  format      String
  filters     Json?
  status      String
  filePath    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String?
  type       String
  priority   String
  title      String
  body       String
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  response       Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([notificationId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  url       String
  secret    String?
  enabled   Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
