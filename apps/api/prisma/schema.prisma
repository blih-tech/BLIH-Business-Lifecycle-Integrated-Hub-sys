  okrId        String            @map("okr_id") @db.Uuid
  okr          Okr               @relation(fields: [okrId], references: [id], onDelete: Cascade)
  title        String            @db.VarChar(512)
  type         KeyResultType
  targetValue  Decimal           @map("target_value") @db.Decimal(15, 4)
  currentValue Decimal?          @map("current_value") @db.Decimal(15, 4)
  progress     Int               @default(0)
  status       KeyResultStatus   @default(NOT_STARTED)
  weight       Int               @default(100)
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  updates      KeyResultUpdate[]

  @@index([okrId])
}

model KeyResultUpdate {
  id            String    @id @default(uuid()) @db.Uuid
  keyResultId   String    @map("key_result_id") @db.Uuid
  keyResult     KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  previousValue Decimal?  @map("previous_value") @db.Decimal(15, 4)
  newValue      Decimal   @map("new_value") @db.Decimal(15, 4)
  comment       String?
  updatedById   String    @map("updated_by_id") @db.Uuid
  updatedBy     User      @relation("KeyResultUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([keyResultId])
  @@index([updatedById])
  @@index([createdAt])
}

