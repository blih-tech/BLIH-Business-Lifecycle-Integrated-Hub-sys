  jobApplicationId     String                 @map("job_application_id") @db.Uuid
  jobApplication       JobApplication         @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)
  candidateSummary     Json?                  @map("candidate_summary") @db.JsonB
  offer                Json?                  @db.JsonB
  selectionReasoning   String?                @map("selection_reasoning") @db.Text
  keyAssets            Json?                  @map("key_assets") @db.JsonB
  attachments          Json?                  @db.JsonB
  submittedById        String                 @map("submitted_by_id") @db.Uuid
