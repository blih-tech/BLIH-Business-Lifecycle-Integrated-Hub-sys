generator client {
  provider     = "prisma-client"
  output       = "../src/platform/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  ANNUAL
}

enum LifecycleStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ON_LEAVE
  TERMINATED
  RESIGNED
  RETIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum DocumentType {
  CONTRACT
  ID
  CERTIFICATE
  MEDICAL
  RESUME
  POLICY_ACK
  QUALIFICATION
  OTHER
}

enum ContractType {
  INITIAL
  RENEWAL
  AMENDMENT
  ADDENDUM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

// Recruitment (HR Implementation Plan 02)
enum RecruitmentRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RecruitmentRequestType {
  NEW
  REPLACEMENT
}

enum JobPostingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  FILLED
  EXPIRED
  CANCELLED
}

enum CandidateStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW_STAGE
  OFFER_PENDING
  HIRED
  REJECTED
  WITHDRAWN
}

enum CandidateSource {
  COMPANY_SITE
  LINKEDIN
  TELEGRAM
  REFERRAL
  AGENCY
}

enum ScreeningRecommendation {
  SELECT
  PAUSE
  DECLINE
}

enum InterviewType {
  HR_SCREENING
  TECHNICAL
  BEHAVIORAL
  PANEL
  FINAL
}

enum EndorsementLevel {
  STRONG_YES
  YES
  UNCERTAIN
  NO
}

enum HiringDecisionOutcome {
  OFFER_APPROVED
  OFFER_DECLINED
  SUSPENDED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Onboarding subsystem (HR Implementation Plan 03)
enum OnboardingChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum OnboardingTaskDepartment {
  HR
  IT
  ADMIN
  TEAM
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ProbationPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProbationEvaluationRound {
  DAY_30
  DAY_55
  DAY_60_FINAL
}

enum ProbationRecommendation {
  CONFIRM
  EXTEND
  TERMINATE
}

enum ProbationConfirmationVerdict {
  CONFIRM
  EXTEND
  TERMINATE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// Attendance & Leave (HR Implementation Plan 04)
enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  STUDY
  EMERGENCY
  COMPASSIONATE
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  ON_LEAVE
  HALF_DAY
  REMOTE
  BUSINESS_TRIP
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AssetProvisioningStatus {
  PENDING
  APPROVED
  PROVISIONED
  REJECTED
  COMPLETED
}

enum ProbationFinalDecision {
  CONFIRM
  EXTEND
  TERMINATE
}

model User {
  id                             String                    @id @default(uuid()) @db.Uuid
  keycloakId                     String                    @unique
  username                       String                    @unique
  email                          String                    @unique
  firstName                      String
  lastName                       String
  phone                          String?
  status                         UserStatus                @default(ACTIVE)
  lastLoginAt                    DateTime?
  metadata                       Json?
  permissions                    String[]                  @default([])
  profile                        UserProfile?
  employment                     UserEmployment?
  compensation                   UserCompensation?
  compensationHistory            UserCompensationHistory[]
  employmentChanges              UserEmploymentHistory[]   @relation("EmploymentChangedBy")
  compensationChanges            UserCompensationHistory[] @relation("CompensationChangedBy")
  lifecycle                      UserLifecycle?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  roles                          UserRole[]
  employeeDocuments              EmployeeDocument[]
  verifiedDocuments              EmployeeDocument[]        @relation("EmployeeDocumentVerifiedBy")
  contracts                      Contract[]
  submittedRecruitmentRequests   RecruitmentRequest[]      @relation("RecruitmentRequestSubmittedBy")
  referredCandidates             Candidate[]               @relation("CandidateReferral")
  screeningDecisions             CvScreening[]             @relation("CvScreeningScreenedBy")
  compiledInterviewFeedback      InterviewFeedback[]       @relation("InterviewFeedbackCompiledBy")
  submittedHiringDecisions       HiringDecision[]          @relation("HiringDecisionSubmittedBy")
  replacementRequests            RecruitmentRequest[]      @relation("RecruitmentRequestReplacementFor")
  hiringDecisionsAsEmployee      HiringDecision[]          @relation("HiringDecisionEmployee")
  givenRecruitmentApprovals      RecruitmentApproval[]     @relation("RecruitmentApprovalApprover")
  onboardings                    Onboarding[]              @relation("OnboardingUser")
  onboardingChecklists           OnboardingChecklist[]     @relation("OnboardingChecklistUser")
  checklistsOverseen             OnboardingChecklist[]     @relation("OnboardingChecklistOverseer")
  assignedOnboardingTasks        OnboardingTask[]          @relation("OnboardingTaskAssignee")
  completedOnboardingTasks       OnboardingTask[]          @relation("OnboardingTaskCompletedBy")
  assetProvisionings             AssetProvisioning[]
  policyAcknowledgements         PolicyAcknowledgement[]
  policyAcknowledgementsVerified PolicyAcknowledgement[]   @relation("PolicyAcknowledgementVerifiedBy")
  probationKpiPlans              ProbationKpiPlan[]        @relation("ProbationKpiPlanUser")
  probationEvaluations           ProbationEvaluation[]     @relation("ProbationEvaluationUser")
  probationConfirmations         ProbationConfirmation[]
  leaveRequests                  LeaveRequest[]            @relation("LeaveRequestEmployee")
  delegatedLeaveHandovers        LeaveRequest[]            @relation("LeaveRequestHandoverDelegate")
  leaveRequestsApproved          LeaveRequest[]            @relation("LeaveRequestApprover")
  leaveApprovals                 LeaveApproval[]           @relation("LeaveApprovalApprover")
  leaveBalances                  LeaveBalance[]
  attendanceLogs                 AttendanceLog[]
  workScheduleAssignments        UserWorkSchedule[]

  @@index([status])
}

model Department {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String                  @unique
  description         String?
  parentId            String?                 @map("parent_id") @db.Uuid
  parent              Department?             @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Department[]            @relation("DepartmentHierarchy")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  positions           Position[]
  employmentHistory   UserEmploymentHistory[]
  recruitmentRequests RecruitmentRequest[]

  @@index([parentId])
}

model Position {
  id                  String                  @id @default(uuid()) @db.Uuid
  title               String
  description         String?
  departmentId        String                  @db.Uuid
  department          Department              @relation(fields: [departmentId], references: [id])
  headcountLimit      Int?                    @map("headcount_limit")
  employments         UserEmployment[]
  jobDescriptions     JobDescription[]
  employmentHistory   UserEmploymentHistory[]
  recruitmentRequests RecruitmentRequest[]
  jobPostings         JobPosting[]
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([departmentId, title])
  @@index([departmentId])
  @@index([isActive])
}

model CountryReference {
  id                  String        @id @default(uuid()) @db.Uuid
  code                String?       @unique @db.VarChar(3)
  name                String        @unique
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  nationalityProfiles UserProfile[] @relation("ProfileNationality")
  residenceProfiles   UserProfile[] @relation("ProfileResidenceCountry")
  holidays            Holiday[]

  @@index([isActive])
}

model UserProfile {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @db.Uuid
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  gender                Gender?
  nationalityId         String?           @db.Uuid
  nationality           CountryReference? @relation("ProfileNationality", fields: [nationalityId], references: [id], onDelete: SetNull)
  maritalStatus         MaritalStatus?
  avatarUrl             String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  countryId             String?           @db.Uuid
  country               CountryReference? @relation("ProfileResidenceCountry", fields: [countryId], references: [id], onDelete: SetNull)
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([nationalityId])
  @@index([countryId])
}

model UserEmployment {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @unique @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode           String?                 @unique
  positionId             String?                 @db.Uuid
  position               Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType         EmploymentType          @default(FULL_TIME)
  managerEmploymentId    String?                 @db.Uuid
  managerEmployment      UserEmployment?         @relation("EmploymentManagerRelation", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  subordinateEmployments UserEmployment[]        @relation("EmploymentManagerRelation")
  history                UserEmploymentHistory[] @relation("EmploymentHistory")
  managedHistoryEntries  UserEmploymentHistory[] @relation("EmploymentHistoryManagerRelation")
  hiredAt                DateTime?
  probationEndAt         DateTime?
  confirmedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([positionId])
  @@index([managerEmploymentId])
}

model UserEmploymentHistory {
  id                  String          @id @default(uuid()) @db.Uuid
  userEmploymentId    String          @db.Uuid
  userEmployment      UserEmployment  @relation("EmploymentHistory", fields: [userEmploymentId], references: [id], onDelete: Cascade)
  employeeCode        String?
  departmentId        String?         @db.Uuid
  department          Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId          String?         @db.Uuid
  position            Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType      EmploymentType  @default(FULL_TIME)
  managerEmploymentId String?         @db.Uuid
  managerEmployment   UserEmployment? @relation("EmploymentHistoryManagerRelation", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  effectiveFrom       DateTime        @default(now())
  effectiveTo         DateTime?
  changeReason        String?
  changedById         String?         @db.Uuid
  changedBy           User?           @relation("EmploymentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())

  @@index([userEmploymentId])
  @@index([departmentId])
  @@index([positionId])
  @@index([managerEmploymentId])
  @@index([changedById])
  @@index([effectiveFrom])
  @@index([userEmploymentId, effectiveFrom])
}

model UserCompensation {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary    Decimal?     @db.Decimal(15, 2)
  currency      String?
  payFrequency  PayFrequency @default(MONTHLY)
  bonusEligible Boolean      @default(false)
  bonusRate     Decimal?     @db.Decimal(5, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model UserCompensationHistory {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary    Decimal?     @db.Decimal(15, 2)
  currency      String?
  payFrequency  PayFrequency @default(MONTHLY)
  bonusEligible Boolean      @default(false)
  bonusRate     Decimal?     @db.Decimal(5, 2)
  validFrom     DateTime
  validTo       DateTime?
  changeReason  String?
  changedById   String?      @db.Uuid
  changedBy     User?        @relation("CompensationChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([userId, validFrom])
  @@index([userId, validTo])
  @@index([changedById])
}

model UserLifecycle {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @unique @db.Uuid
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               LifecycleStatus @default(ONBOARDING)
  onboardedAt          DateTime?
  suspendedAt          DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  offboardingCompleted Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Role {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  displayName  String
  description  String?
  parentRoleId String?          @db.Uuid
  parentRole   Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   Role[]           @relation("RoleHierarchy")
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([name])
  @@index([parentRoleId])
}

model PermissionResource {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model PermissionAction {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  resourceId  String             @db.Uuid
  actionId    String             @db.Uuid
  resource    PermissionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  action      PermissionAction   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  slug        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  roleLinks   RolePermission[]

  @@unique([resourceId, actionId])
  @@index([resourceId])
  @@index([actionId])
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  assignedBy String?   @db.Uuid
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  action        String
  module        String
  resource      String
  resourceId    String?
  actorUserId   String?
  actorEmail    String?
  requestId     String
  correlationId String
  sessionId     String?
  ipAddress     String
  userAgent     String
  result        AuditResult @default(SUCCESS)
  statusCode    Int?
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
  @@index([actorUserId])
  @@index([action, resource])
}

model AuditExport {
  id          String    @id @default(uuid()) @db.Uuid
  requestedBy String
  format      String
  filters     Json?
  status      String
  filePath    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String?
  type       String
  priority   String
  title      String
  body       String
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  response       Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([notificationId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  url       String
  secret    String?
  enabled   Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ModuleConfig {
  id         String   @id @default(uuid()) @db.Uuid
  module     String   @unique
  enabled    Boolean  @default(true)
  licenseKey String?
  settings   Json?
  updatedAt  DateTime @updatedAt
}

model SecurityPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  requireMfa            Boolean  @default(true)
  maxConcurrentSessions Int      @default(3)
  sessionTimeoutMinutes Int      @default(480)
  passwordMinLength     Int      @default(12)
  lockoutThreshold      Int      @default(5)
  updatedAt             DateTime @updatedAt
}

model WorkSchedule {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String             @unique
  description           String?
  timezone              String?            @db.VarChar(64)
  isDefault             Boolean            @default(false) @map("is_default")
  lateThresholdMinutes  Int                @default(15) @map("late_threshold_minutes")
  standardMinutesPerDay Int                @default(480) @map("standard_minutes_per_day")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assignments           UserWorkSchedule[]
  days                  WorkScheduleDay[]

  @@index([isDefault])
}

model WorkScheduleDay {
  id              String       @id @default(uuid()) @db.Uuid
  scheduleId      String       @map("schedule_id") @db.Uuid
  schedule        WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek       DayOfWeek    @map("day_of_week")
  isWorkingDay    Boolean      @default(true) @map("is_working_day")
  startMinute     Int?         @map("start_minute")
  endMinute       Int?         @map("end_minute")
  expectedMinutes Int?         @map("expected_minutes")
  remoteAllowed   Boolean      @default(false) @map("remote_allowed")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
}

model UserWorkSchedule {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  scheduleId    String       @map("schedule_id") @db.Uuid
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([scheduleId])
  @@index([userId, effectiveFrom])
}

model Holiday {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  date              DateTime          @db.Date
  countryId         String?           @map("country_id") @db.Uuid
  country           CountryReference? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  isRecurringAnnual Boolean           @default(false) @map("is_recurring_annual")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date])
  @@index([countryId])
  @@unique([name, date, countryId])
}

model EmployeeDocument {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          DocumentType
  typeOther     String?      @map("type_other")
  fileUrl       String       @map("file_url")
  fileName      String?      @map("file_name")
  fileSizeBytes Int?         @map("file_size_bytes")
  mimeType      String?      @map("mime_type")
  issueDate     DateTime?    @map("issue_date") @db.Date
  expiryDate    DateTime?    @map("expiry_date") @db.Date
  isMandatory   Boolean      @default(false) @map("is_mandatory")
  verified      Boolean      @default(false)
  verifiedById  String?      @map("verified_by_id") @db.Uuid
  verifiedBy    User?        @relation("EmployeeDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt    DateTime?    @map("verified_at")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([expiryDate])
  @@index([verifiedById])
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractType    ContractType   @map("contract_type")
  sequenceNumber  Int            @map("sequence_number")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  trialApplies    Boolean        @default(false) @map("trial_applies")
  trialEndDate    DateTime?      @map("trial_end_date") @db.Date
  trialConfirmed  Boolean        @default(false) @map("trial_confirmed")
  documentUrl     String?        @map("document_url")
  status          ContractStatus @default(DRAFT)
  syncedToFinance Boolean        @default(false) @map("synced_to_finance")
  syncedAt        DateTime?      @map("synced_at")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([userId, sequenceNumber])
  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model JobDescription {
  id            String    @id @default(uuid()) @db.Uuid
  positionId    String?   @map("position_id") @db.Uuid
  position      Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  title         String
  level         String?
  code          String?   @unique
  summary       String?   @db.Text
  duties        Json?
  skills        Json?
  kpis          Json?
  documentUrl   String?   @map("document_url")
  version       Int       @default(1)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([positionId])
  @@index([title])
}

// Recruitment (HR Plan 02)
model RecruitmentRequest {
  id                 String                   @id @default(uuid()) @db.Uuid
  requestId          String                   @unique @map("request_id") @db.VarChar(32)
  departmentId       String                   @map("department_id") @db.Uuid
  department         Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId         String?                  @map("position_id") @db.Uuid
  position           Position?                @relation(fields: [positionId], references: [id], onDelete: SetNull)
  type               RecruitmentRequestType   @default(NEW)
