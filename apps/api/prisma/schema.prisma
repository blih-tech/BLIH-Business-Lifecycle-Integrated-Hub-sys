generator client {
  provider     = "prisma-client"
  output       = "../src/platform/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Recruitment (Enterprise Canonical)
// Job workflow: DRAFT -> PENDING_FOR_APPROVAL -> READY_TO_POST -> PUBLISHED -> CLOSED (or REJECTED on rejection)

model CandidateSkill {
  id          String      @id @default(uuid()) @db.Uuid
  candidateId String      @map("candidate_id") @db.Uuid
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(128)
  level       SkillLevel?
  years       Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([candidateId, name])
  @@index([candidateId])
}

model ProbationConfirmation {
  id                     String                       @id @default(uuid()) @db.Uuid
  employeeId             String                       @map("employee_id") @db.Uuid
  employee               Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewSummary          Json?                        @map("review_summary") @db.JsonB
  verdict                ProbationConfirmationVerdict
  extension              Json?                        @db.JsonB
  termination            Json?                        @db.JsonB
  confirmation           Json?                        @db.JsonB
  hrCheckedAt            DateTime?                    @map("hr_checked_at")
  ceoSignOffAt           DateTime?                    @map("ceo_sign_off_at")
  employeeNotifiedAt     DateTime?                    @map("employee_notified_at")
  archivedInEmployeeFile Boolean                      @default(false) @map("archived_in_employee_file")
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@index([employeeId])
}

model LeaveRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  requestId          String             @unique @map("request_id") @db.VarChar(32)
  employeeId         String             @map("employee_id") @db.Uuid
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType          @map("leave_type")
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime           @map("end_date") @db.Date
  daysRequested      Decimal            @map("days_requested") @db.Decimal(5, 2)
  reason             String?            @db.Text
  description        String?            @db.Text
  contactDuringLeave Json?              @map("contact_during_leave") @db.JsonB
  handoverDelegateId String?            @map("handover_delegate_id") @db.Uuid
  handoverDelegate   User?              @relation("LeaveRequestHandoverDelegate", fields: [handoverDelegateId], references: [id], onDelete: SetNull)
  handoverNotes      String?            @map("handover_notes") @db.Text
  startHalfDay       Boolean            @default(false) @map("start_half_day")
  endHalfDay         Boolean            @default(false) @map("end_half_day")
  balanceSnapshot    Json?              @map("balance_snapshot") @db.JsonB
  submittedAt        DateTime?          @map("submitted_at")
  approvalSteps      LeaveApproval[]    @relation("LeaveRequestApprovals")
  status             LeaveRequestStatus @default(DRAFT)
  approvedById       String?            @map("approved_by_id") @db.Uuid
  approvedBy         User?              @relation("LeaveRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?          @map("approved_at")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedById])
  @@index([submittedAt])
}

model LeaveApproval {
  id             String           @id @default(uuid()) @db.Uuid
  leaveRequestId String           @map("leave_request_id") @db.Uuid
  leaveRequest   LeaveRequest     @relation("LeaveRequestApprovals", fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approverId     String           @map("approver_id") @db.Uuid
  approver       User             @relation("LeaveApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)
  level          Int
  decision       ApprovalDecision @default(PENDING)
  comments       String?          @db.Text
  decidedAt      DateTime?        @map("decided_at")
  createdAt      DateTime         @default(now())

  @@unique([leaveRequestId, level])
  @@index([leaveRequestId])
  @@index([approverId])
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  leaveType   LeaveType @map("leave_type")
  year        Int
  totalDays   Decimal   @map("total_days") @db.Decimal(5, 2)
  usedDays    Decimal   @default(0) @map("used_days") @db.Decimal(5, 2)
  pendingDays Decimal   @default(0) @map("pending_days") @db.Decimal(5, 2)
  carriedOver Decimal?  @default(0) @map("carried_over") @db.Decimal(5, 2)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
}

model AttendanceLog {
  id                 String                        @id @default(uuid()) @db.Uuid
  employeeId         String                        @map("employee_id") @db.Uuid
  employee           Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  correctionRequests AttendanceCorrectionRequest[]
  overtimeRequests   OvertimeRequest[]
  date               DateTime                      @db.Date
  checkInAt          DateTime?                     @map("check_in_at")
  checkOutAt         DateTime?                     @map("check_out_at")
  totalMinutes       Int?                          @map("total_minutes")
  status             AttendanceStatus              @default(PRESENT)
  isAutoCalculated   Boolean                       @default(true) @map("is_auto_calculated")
  overtimeMinutes    Int?                          @map("overtime_minutes")
  overtimeApproved   Boolean                       @default(false) @map("overtime_approved")
  checkInMethod      String?                       @map("check_in_method") @db.VarChar(32)
  checkOutMethod     String?                       @map("check_out_method") @db.VarChar(32)
  checkInIp          String?                       @map("check_in_ip") @db.VarChar(64)
  checkInLocation    Json?                         @map("check_in_location") @db.JsonB
  reconciledAt       DateTime?                     @map("reconciled_at")
  notes              String?                       @db.Text
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([employeeId, date])
  @@index([date])
  @@index([status])
}

model AttendanceCorrectionRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  requestId           String                @unique @map("request_id") @db.VarChar(32)
  employeeId          String                @map("employee_id") @db.Uuid
  employee            Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceLogId     String?               @map("attendance_log_id") @db.Uuid
  attendanceLog       AttendanceLog?        @relation(fields: [attendanceLogId], references: [id], onDelete: SetNull)
  date                DateTime              @db.Date
  requestedCheckInAt  DateTime?             @map("requested_check_in_at")
  requestedCheckOutAt DateTime?             @map("requested_check_out_at")
  requestedStatus     AttendanceStatus?     @map("requested_status")
  reason              String                @db.Text
  notes               String?               @db.Text
  status              RequestWorkflowStatus @default(DRAFT)
  submittedAt         DateTime?             @map("submitted_at")
  approvedById        String?               @map("approved_by_id") @db.Uuid
  approvedBy          User?                 @relation("AttendanceCorrectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?             @map("approved_at")
  rejectionReason     String?               @map("rejection_reason") @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([employeeId])
  @@index([attendanceLogId])
  @@index([date])
  @@index([status])
  @@index([approvedById])
}

model OvertimeRequest {
  id               String                @id @default(uuid()) @db.Uuid
  requestId        String                @unique @map("request_id") @db.VarChar(32)
  employeeId       String                @map("employee_id") @db.Uuid
  employee         Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceLogId  String?               @map("attendance_log_id") @db.Uuid
  attendanceLog    AttendanceLog?        @relation(fields: [attendanceLogId], references: [id], onDelete: SetNull)
  date             DateTime              @db.Date
  requestedMinutes Int                   @map("requested_minutes")
  reason           String                @db.Text
  notes            String?               @db.Text
  status           RequestWorkflowStatus @default(DRAFT)
  submittedAt      DateTime?             @map("submitted_at")
  approvedById     String?               @map("approved_by_id") @db.Uuid
  approvedBy       User?                 @relation("OvertimeRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?             @map("approved_at")
  rejectionReason  String?               @map("rejection_reason") @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([employeeId])
  @@index([attendanceLogId])
  @@index([date])
  @@index([status])
  @@index([approvedById])
}

model FlexWorkRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  requestId            String                @unique @map("request_id") @db.VarChar(32)
  employeeId           String                @map("employee_id") @db.Uuid
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType          FlexWorkRequestType   @map("request_type")
  startDate            DateTime              @map("start_date") @db.Date
  endDate              DateTime              @map("end_date") @db.Date
  requestedStartMinute Int?                  @map("requested_start_minute")
  requestedEndMinute   Int?                  @map("requested_end_minute")
  reason               String                @db.Text
  details              Json?                 @db.JsonB
  status               RequestWorkflowStatus @default(DRAFT)
  submittedAt          DateTime?             @map("submitted_at")
  approvedById         String?               @map("approved_by_id") @db.Uuid
  approvedBy           User?                 @relation("FlexWorkRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?             @map("approved_at")
  rejectionReason      String?               @map("rejection_reason") @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([employeeId])
  @@index([requestType])
  @@index([startDate, endDate])
  @@index([status])
  @@index([approvedById])
}

model Timesheet {
  id                  String                @id @default(uuid()) @db.Uuid
  timesheetId         String                @unique @map("timesheet_id") @db.VarChar(32)
  employeeId          String                @map("employee_id") @db.Uuid
  employee            Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart         DateTime              @map("period_start") @db.Date
  periodEnd           DateTime              @map("period_end") @db.Date
  trackedDays         Int                   @default(0) @map("tracked_days")
  workedDays          Int                   @default(0) @map("worked_days")
  leaveDays           Decimal               @default(0) @map("leave_days") @db.Decimal(5, 2)
  absenceDays         Decimal               @default(0) @map("absence_days") @db.Decimal(5, 2)
  remoteDays          Int                   @default(0) @map("remote_days")
  lateCount           Int                   @default(0) @map("late_count")
  earlyDepartureCount Int                   @default(0) @map("early_departure_count")
  totalWorkedMinutes  Int                   @default(0) @map("total_worked_minutes")
  overtimeMinutes     Int                   @default(0) @map("overtime_minutes")
  attendanceRate      Decimal               @default(0) @map("attendance_rate") @db.Decimal(5, 2)
  punctualityRate     Decimal               @default(0) @map("punctuality_rate") @db.Decimal(5, 2)
  sourceSnapshot      Json?                 @map("source_snapshot") @db.JsonB
  notes               String?               @db.Text
  status              RequestWorkflowStatus @default(DRAFT)
  submittedAt         DateTime?             @map("submitted_at")
  approvedById        String?               @map("approved_by_id") @db.Uuid
  approvedBy          User?                 @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?             @map("approved_at")
  rejectionReason     String?               @map("rejection_reason") @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([approvedById])
}

model ReviewPeriodConfig {
  id                  String                   @id @default(uuid()) @db.Uuid
  year                Int
  quarter             Int
  type                ReviewPeriodType         @default(QUARTERLY)
  windowOpensAt       DateTime                 @map("window_opens_at")
  selfAssessmentDueAt DateTime                 @map("self_assessment_due_at")
  managerReviewDueAt  DateTime                 @map("manager_review_due_at")
  windowClosesAt      DateTime                 @map("window_closes_at")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  reviews             PerformanceReview[]
  calibrations        PerformanceCalibration[]

  @@unique([year, quarter])
  @@index([year])
}

model PerformanceReview {
  id                       String                      @id @default(uuid()) @db.Uuid
  employeeId               String                      @map("employee_id") @db.Uuid
  employee                 Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodConfigId           String                      @map("period_config_id") @db.Uuid
  periodConfig             ReviewPeriodConfig          @relation(fields: [periodConfigId], references: [id], onDelete: Restrict)
  selfAssessment           Json?                       @map("self_assessment") @db.JsonB
  managerReview            Json?                       @map("manager_review") @db.JsonB
  finalRating              Decimal?                    @map("final_rating") @db.Decimal(3, 2)
  category                 PerformanceCategory?        @map("category")
  raiseRecommendation      Json?                       @map("raise_recommendation") @db.JsonB
  promotionEligible        Boolean                     @default(false) @map("promotion_eligible")
  completedAt              DateTime?                   @map("completed_at")
  status                   ReviewStatus                @default(NOT_STARTED)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  feedbackEntries          PerformanceReviewFeedback[]
  trainingNeedsAssessments TrainingNeedsAssessment[]
  salaryAdjustmentRequests SalaryAdjustmentRequest[]

  @@unique([employeeId, periodConfigId])
  @@index([employeeId])
  @@index([periodConfigId])
  @@index([status])
}

model PerformanceReviewFeedback {
  id          String                  @id @default(uuid()) @db.Uuid
  reviewId    String                  @map("review_id") @db.Uuid
  review      PerformanceReview       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewerId  String                  @map("reviewer_id") @db.Uuid
  reviewer    User                    @relation("PerformanceReviewFeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  role        PerformanceFeedbackRole
  ratings     Json?                   @db.JsonB
  comments    Json?                   @db.JsonB
  submittedAt DateTime?               @map("submitted_at")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([reviewId, reviewerId, role])
  @@index([reviewId])
  @@index([reviewerId])
  @@index([role])
}

model PerformanceCalibration {
  id            String             @id @default(uuid()) @db.Uuid
  periodId      String             @map("period_id") @db.Uuid
  period        ReviewPeriodConfig @relation(fields: [periodId], references: [id], onDelete: Cascade)
  departmentId  String?            @map("department_id") @db.Uuid
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  adjustments   Json?              @db.JsonB
  finalizedById String?            @map("finalized_by_id") @db.Uuid
  finalizedBy   User?              @relation("PerformanceCalibrationFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  finalizedAt   DateTime?          @map("finalized_at")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([periodId, departmentId])
  @@index([periodId])
  @@index([departmentId])
  @@index([finalizedById])
}

model Okr {
  id              String             @id @default(uuid()) @db.Uuid
  employeeId      String?            @map("employee_id") @db.Uuid
  employee        Employee?          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  scope           OkrScope           @default(USER)
  departmentId    String?            @map("department_id") @db.Uuid
  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parentOkrId     String?            @map("parent_okr_id") @db.Uuid
  parentOkr       Okr?               @relation("OkrHierarchy", fields: [parentOkrId], references: [id], onDelete: SetNull)
  childOkrs       Okr[]              @relation("OkrHierarchy")
  periodYear      Int                @map("period_year")
  periodQuarter   Int                @map("period_quarter")
  title           String             @db.VarChar(512)
  description     String?            @db.Text
  status          OkrStatus          @default(DRAFT)
  overallProgress Int                @default(0) @map("overall_progress")
  overallStatus   OkrStatus          @default(ACTIVE) @map("overall_status")
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  keyResults      KeyResult[]
  managerReviews  OkrManagerReview[]

  @@index([employeeId])
  @@index([scope])
  @@index([departmentId])
  @@index([parentOkrId])
  @@index([periodYear, periodQuarter])
  @@index([status])
}

model KeyResult {
  id           String            @id @default(uuid()) @db.Uuid
  okrId        String            @map("okr_id") @db.Uuid
  okr          Okr               @relation(fields: [okrId], references: [id], onDelete: Cascade)
  title        String            @db.VarChar(512)
  type         KeyResultType
  targetValue  Decimal           @map("target_value") @db.Decimal(15, 4)
  currentValue Decimal?          @map("current_value") @db.Decimal(15, 4)
  progress     Int               @default(0)
  status       KeyResultStatus   @default(NOT_STARTED)
  weight       Int               @default(100)
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  updates      KeyResultUpdate[]

  @@index([okrId])
}

model KeyResultUpdate {
  id            String    @id @default(uuid()) @db.Uuid
  keyResultId   String    @map("key_result_id") @db.Uuid
  keyResult     KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  previousValue Decimal?  @map("previous_value") @db.Decimal(15, 4)
  newValue      Decimal   @map("new_value") @db.Decimal(15, 4)
  comment       String?
  updatedById   String    @map("updated_by_id") @db.Uuid
  updatedBy     User      @relation("KeyResultUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([keyResultId])
  @@index([updatedById])
  @@index([createdAt])
}

model SuccessionPlan {
  id                  String              @id @default(uuid()) @db.Uuid
  positionId          String              @map("position_id") @db.Uuid
  position            Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateEmployeeId String              @map("candidate_employee_id") @db.Uuid
  candidateEmployee   Employee            @relation("SuccessionCandidateEmployee", fields: [candidateEmployeeId], references: [id], onDelete: Cascade)
  readiness           SuccessionReadiness
  riskLevel           SuccessionRiskLevel @map("risk_level")
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([positionId, candidateEmployeeId])
  @@index([positionId])
  @@index([candidateEmployeeId])
  @@index([readiness])
}

model PromotionProposal {
  id             String                  @id @default(uuid()) @db.Uuid
  employeeId     String                  @map("employee_id") @db.Uuid
  employee       Employee                @relation("PromotionProposalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  fromPositionId String?                 @map("from_position_id") @db.Uuid
  fromPosition   Position?               @relation("PromotionProposalFromPosition", fields: [fromPositionId], references: [id], onDelete: SetNull)
  toPositionId   String?                 @map("to_position_id") @db.Uuid
  toPosition     Position?               @relation("PromotionProposalToPosition", fields: [toPositionId], references: [id], onDelete: SetNull)
  proposedById   String                  @map("proposed_by_id") @db.Uuid
  proposedBy     User                    @relation("PromotionProposalProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  justification  Json?                   @db.JsonB
  status         PromotionProposalStatus @default(PENDING)
  approvedById   String?                 @map("approved_by_id") @db.Uuid
  approvedBy     User?                   @relation("PromotionProposalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?               @map("approved_at")
  rejectedAt     DateTime?               @map("rejected_at")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([employeeId])
  @@index([fromPositionId])
  @@index([toPositionId])
  @@index([proposedById])
  @@index([approvedById])
  @@index([status])
}

model CareerDevelopmentPlan {
  id                 String                      @id @default(uuid()) @db.Uuid
  employeeId         String                      @map("employee_id") @db.Uuid
  employee           Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentPositionId  String?                     @map("current_position_id") @db.Uuid
  currentPosition    Position?                   @relation("CareerPlanCurrentPosition", fields: [currentPositionId], references: [id], onDelete: SetNull)
  targetPositionId   String?                     @map("target_position_id") @db.Uuid
  targetPosition     Position?                   @relation("CareerPlanTargetPosition", fields: [targetPositionId], references: [id], onDelete: SetNull)
  planYear           Int                         @map("plan_year")
  title              String                      @db.VarChar(255)
  summary            String?                     @db.Text
  goals              Json                        @db.JsonB
  developmentActions Json?                       @map("development_actions") @db.JsonB
  successMetrics     Json?                       @map("success_metrics") @db.JsonB
  progressPercent    Int                         @default(0) @map("progress_percent")
  lastProgressAt     DateTime?                   @map("last_progress_at")
  completedAt        DateTime?                   @map("completed_at")
  status             CareerDevelopmentPlanStatus @default(DRAFT)
  createdById        String                      @map("created_by_id") @db.Uuid
  createdBy          User                        @relation("CareerPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([employeeId])
  @@index([currentPositionId])
  @@index([targetPositionId])
  @@index([planYear])
  @@index([status])
  @@index([createdById])
}

model TrainingNeedsAssessment {
  id                 String                @id @default(uuid()) @db.Uuid
  employeeId         String                @map("employee_id") @db.Uuid
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basedOnReviewId    String?               @map("based_on_review_id") @db.Uuid
  basedOnReview      PerformanceReview?    @relation(fields: [basedOnReviewId], references: [id], onDelete: SetNull)
  periodYear         Int                   @map("period_year")
  assessedById       String                @map("assessed_by_id") @db.Uuid
  assessedBy         User                  @relation("TrainingNeedsAssessmentAssessor", fields: [assessedById], references: [id], onDelete: Restrict)
  developmentAreas   Json                  @map("development_areas") @db.JsonB
  requestedTrainings Json                  @map("requested_trainings") @db.JsonB
  skillGapSummary    String?               @map("skill_gap_summary") @db.Text
  managerNotes       String?               @map("manager_notes") @db.Text
  priority           String?               @db.VarChar(32)
  status             RequestWorkflowStatus @default(DRAFT)
  submittedAt        DateTime?             @map("submitted_at")
  reviewedById       String?               @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?                 @relation("TrainingNeedsAssessmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?             @map("reviewed_at")
  rejectionReason    String?               @map("rejection_reason") @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([employeeId])
  @@index([basedOnReviewId])
  @@index([periodYear])
  @@index([assessedById])
  @@index([reviewedById])
  @@index([status])
}

model InternalTransferRequest {
  id                   String                    @id @default(uuid()) @db.Uuid
  requestId            String                    @unique @map("request_id") @db.VarChar(32)
  employeeId           String                    @map("employee_id") @db.Uuid
  employee             Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType          InternalTransferType      @map("request_type")
  currentPositionId    String?                   @map("current_position_id") @db.Uuid
  currentPosition      Position?                 @relation("InternalTransferCurrentPosition", fields: [currentPositionId], references: [id], onDelete: SetNull)
  targetPositionId     String                    @map("target_position_id") @db.Uuid
  targetPosition       Position                  @relation("InternalTransferTargetPosition", fields: [targetPositionId], references: [id], onDelete: Restrict)
