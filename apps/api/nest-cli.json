{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "entryFile": "apps/api/src/main",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "src/**/*",
        "exclude": "**/apps/web/**",
        "watchAssets": true
      },
      "**/*.json",
      "**/*.md",
      "**/*.txt"
    ]
  }
}
