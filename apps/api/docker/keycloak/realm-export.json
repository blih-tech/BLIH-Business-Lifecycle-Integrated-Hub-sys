{
  "id": "blih-dev",
  "realm": "blih-dev",
  "enabled": true,
  "displayName": "BLIH System dev",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "blih-system-auth",
      "name": "BLIH System Auth Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "my-blih-auth-secret-2026",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5000/api/v1/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "audience-blih-api"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "blih-system-api",
      "name": "BLIH System API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "my-blih-api-secret-2026",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "authorizationServicesEnabled": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "superadmin",
        "description": "Full system access",
        "composite": true,
        "composites": {
          "realm": [
            "hr",
            "hr_manager",
            "hr_assistant",
            "finance",
            "finance_manager",
            "finance_accountant",
            "project_manager",
            "pm_lead",
            "pm_member",
            "crm_manager",
            "crm_lead",
            "crm_agent",
            "brain_operator",
            "brain_admin",
            "brain_viewer"
          ]
        }
      },
      {
        "name": "hr",
        "description": "Human Resources",
        "composite": true,
        "composites": {
          "realm": ["hr_manager", "hr_assistant"]
        }
      },
      {
        "name": "finance",
        "description": "Finance",
        "composite": true,
        "composites": {
          "realm": ["finance_manager", "finance_accountant"]
        }
      },
      {
        "name": "project_manager",
        "description": "Project Management",
        "composite": true,
        "composites": {
          "realm": ["pm_lead", "pm_member"]
        }
      },
      {
        "name": "crm_manager",
        "description": "CRM Management",
        "composite": true,
        "composites": {
          "realm": ["crm_lead", "crm_agent"]
        }
      },
      {
        "name": "brain_operator",
        "description": "Brain Operator",
        "composite": true,
        "composites": {
          "realm": ["brain_admin", "brain_viewer"]
        }
      },
      { "name": "hr_manager", "description": "HR Manager" },
      { "name": "hr_assistant", "description": "HR Assistant" },
      { "name": "finance_manager", "description": "Finance Manager" },
      { "name": "finance_accountant", "description": "Finance Accountant" },
      { "name": "pm_lead", "description": "PM Lead" },
      { "name": "pm_member", "description": "PM Member" },
      { "name": "crm_lead", "description": "CRM Lead" },
      { "name": "crm_agent", "description": "CRM Agent" },
      { "name": "brain_admin", "description": "Brain Admin" },
      { "name": "brain_viewer", "description": "Brain Viewer" }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.id.token": "true",
        "include.in.access.token": "true",
        "include.in.userinfo": "true"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "audience-blih-api",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "blih-system-api",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ]
}
