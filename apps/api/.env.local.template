# =============================================================================
# BLIH System Core - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and update the values for your environment
# This file contains all available configuration options with documentation

# =============================================================================
# Application Configuration
# =============================================================================
# Environment: development, staging, production
NODE_ENV=development

# Server port for the API service
PORT=5000

# API prefix for all routes
API_PREFIX=api/v1

# CORS origins (comma-separated, use * for all)
CORS_ORIGIN=*

# Enable/disable Swagger documentation
SWAGGER_ENABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blih_core

# Skip database connection (useful for testing)
SKIP_DATABASE_CONNECT=false

# =============================================================================
# Keycloak Authentication & Authorization
# =============================================================================
# Enable Keycloak integration
KEYCLOAK_ENABLED=true

# Keycloak server URL
KEYCLOAK_URL=http://localhost:8080

# Default realm to use
KEYCLOAK_REALM=blih

# Client ID for the backend API service
KEYCLOAK_CLIENT_ID=blih-system-api

# Client secret (replace with actual secret after Keycloak setup)
KEYCLOAK_CLIENT_SECRET=<replace>
KEYCLOAK_AUTH_CLIENT_ID=blih-system-auth
KEYCLOAK_AUTH_CLIENT_SECRET=<replace>
KEYCLOAK_AUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/callback
KEYCLOAK_AUTH_SCOPES=openid profile email

# Admin client ID for administrative operations
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli



# Admin username for bootstrap operations
KEYCLOAK_ADMIN_USERNAME=admin

# Admin password for bootstrap operations
KEYCLOAK_ADMIN_PASSWORD=admin

# Trust principal headers from an internal gateway (requires shared secret)
TRUST_PROXY_PRINCIPAL_HEADERS=false

# Shared secret expected in x-internal-auth when trusted headers are enabled
INTERNAL_AUTH_SHARED_SECRET=<replace>

# Set false for local/dev so privileged roles (e.g. superadmin) can call /auth/me without MFA; set true in production
ENFORCE_MFA_FOR_PRIVILEGED=false

# Version emitted in auth principal context
AUTH_POLICY_VERSION=1.0
AUTH_LOGIN_ERROR_REDIRECT_URI=/login
AUTH_POST_LOGIN_REDIRECT_URI=/
AUTH_POST_LOGOUT_REDIRECT_URI=/login
AUTH_STATE_TTL_SECONDS=600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# =============================================================================
# JWT Configuration
# =============================================================================
# Expected audience for JWT tokens (must match Keycloak audience mapper: included.client.audience in realm)
JWT_EXPECTED_AUDIENCE=blih-system-api

# Expected issuer for JWT tokens (leave empty for auto-detection)
JWT_EXPECTED_ISSUER=

# =============================================================================
# Message Broker (RabbitMQ) Configuration
# =============================================================================
# Enable RabbitMQ integration
RABBITMQ_ENABLED=false

# RabbitMQ connection URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Exchange name for events
RABBITMQ_EXCHANGE=blih.events

# Dead letter queue name
RABBITMQ_DLQ=core.dlq

# Event contract metadata version
EVENT_CONTRACT_VERSION=1.0

# Prefix used to build metadata.schema when publishing events
EVENT_SCHEMA_PREFIX=blih.event

# Supported major version for inbound events (unknown majors are ignored)
EVENT_SUPPORTED_MAJOR_VERSION=1

# Maximum retry attempts for failed messages
MAX_RETRY_ATTEMPTS=3

# Backoff time between retries (in milliseconds)
RETRY_BACKOFF_MS=1000

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
# Enable email notifications
SMTP_ENABLED=false

# SMTP server hostname
SMTP_HOST=localhost

# SMTP server port
SMTP_PORT=1025

# Use secure connection (TLS/SSL)
SMTP_SECURE=false

# SMTP username
SMTP_USER=noreply@blih.local

# SMTP password
SMTP_PASSWORD=changeme

# From email address
EMAIL_FROM=BLIH System <noreply@blih.local>

# =============================================================================
# Security & Rate Limiting
# =============================================================================
# Rate limiting TTL in milliseconds
RATE_LIMIT_TTL_MS=60000

# Maximum requests per TTL window
RATE_LIMIT_MAX_REQUESTS=100

# Enable Helmet security headers
HELMET_ENABLED=true

# =============================================================================
# Audit & Logging Configuration
# =============================================================================
# Number of days to retain audit logs
AUDIT_RETENTION_DAYS=2555

# Principal enrichment cache TTL (milliseconds)
PRINCIPAL_CONTEXT_TTL_MS=30000

# Keep false when Core DB is canonical for RBAC policy writes
SYNC_ROLES_FROM_KEYCLOAK=false

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log format: json, simple
LOG_FORMAT=json

# =============================================================================
# Background Jobs Configuration
# =============================================================================
# Sync users from Keycloak (cron expression: minute hour day month weekday)
SYNC_USERS_CRON=0 */30 * * * *

# Sync roles from Keycloak (cron expression)
SYNC_ROLES_CRON=0 0 */2 * * *

# Rotate client secrets (cron expression)
ROTATE_SECRETS_CRON=0 0 1 * *

# Cleanup audit logs (cron expression)
CLEANUP_AUDIT_CRON=0 0 2 * *

# =============================================================================
# Health Check Configuration
# =============================================================================
# Enable health check endpoints
HEALTH_CHECK_ENABLED=true

# Health check timeout in milliseconds
HEALTH_CHECK_TIMEOUT_MS=5000

# =============================================================================
# WebSocket Configuration (for real-time notifications)
# =============================================================================
# Enable WebSocket support
WEBSOCKET_ENABLED=true

# WebSocket port (if different from main port)
WEBSOCKET_PORT=5001

# WebSocket path
WEBSOCKET_PATH=/socket.io

# =============================================================================
# Development & Debugging
# =============================================================================
# Enable debug mode for additional logging
DEBUG=false

# Enable request/response logging
LOG_REQUESTS=true

# Enable performance monitoring
PERFORMANCE_MONITORING=true

# =============================================================================
# Advanced Configuration
# =============================================================================
# Database connection pool size
DATABASE_POOL_SIZE=10

# Database connection timeout in milliseconds
DATABASE_TIMEOUT_MS=5000

# Database idle timeout in milliseconds
DATABASE_IDLE_TIMEOUT_MS=300000

# Keycloak connection timeout in milliseconds
KEYCLOAK_TIMEOUT_MS=10000

# RabbitMQ connection timeout in milliseconds
RABBITMQ_TIMEOUT_MS=10000

# Maximum request payload size in bytes
MAX_PAYLOAD_SIZE=10485760

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# =============================================================================
# Feature Flags
# =============================================================================
# Enable multi-realm support
MULTI_REALM_ENABLED=true

# Enable organization hierarchy
ORGANIZATION_HIERARCHY_ENABLED=true

# Enable advanced RBAC features
ADVANCED_RBAC_ENABLED=true

# Enable audit export functionality
AUDIT_EXPORT_ENABLED=true

# Enable notification batching
NOTIFICATION_BATCHING_ENABLED=true

# =============================================================================
# Production Overrides (uncomment for production)
# =============================================================================
# NODE_ENV=production
# CORS_ORIGIN=https://yourdomain.com,https://api.yourdomain.com
# SWAGGER_ENABLED=false
# LOG_LEVEL=warn
# DEBUG=false
# LOG_REQUESTS=false
# PERFORMANCE_MONITORING=false
# SMTP_ENABLED=true
# SMTP_HOST=your-smtp-server.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=BLIH System <noreply@yourdomain.com>
# DATABASE_POOL_SIZE=20
# DATABASE_TIMEOUT_MS=10000
# KEYCLOAK_TIMEOUT_MS=5000
# RABBITMQ_TIMEOUT_MS=5000
# MAX_PAYLOAD_SIZE=5242880
# REQUEST_TIMEOUT_MS=10000

