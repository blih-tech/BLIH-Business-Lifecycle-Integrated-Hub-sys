{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@repo/database/prisma-adapter$": "<rootDir>/../src/platform/prisma/prisma.adapter.jest.ts",
    "^@repo/database/prisma-client$": "<rootDir>/../src/platform/prisma/prisma-client.jest.ts",
    "^@repo/database/generated/enums$": "<rootDir>/../../../packages/database/src/generated/enums.ts"
  },
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(.*\\.mjs$|@prisma/adapter-pg|@prisma/client|jose))"
  ]
}
