# =============================================================================
# BLIH System Core - Environment Configuration
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
API_HOST=0.0.0.0
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=https://project-k22it.vercel.app,https://blihapi.blihmarketing.com,http://localhost:3000,https://localhost:3000
SWAGGER_ENABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_DB=blih-system
POSTGRES_PASSWORD=admin1234
DATABASE_URL=postgresql://postgres:admin1234@postgres:5432/blih-system
SKIP_DATABASE_CONNECT=false
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=300000

# =============================================================================
# Keycloak Authentication & Authorization
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=https://keycloak.blihmarketing.com
KEYCLOAK_REALM=blih

# Resource server client
KEYCLOAK_CLIENT_ID=blih-system-api
KEYCLOAK_CLIENT_SECRET=my-blih-api-secret-2026

# Authentication client
KEYCLOAK_AUTH_CLIENT_ID=blih-system-auth
KEYCLOAK_AUTH_CLIENT_SECRET=my-blih-auth-secret-2026
KEYCLOAK_AUTH_REDIRECT_URI=https://blihapi.blihmarketing.com/api/v1/auth/callback
KEYCLOAK_AUTH_SCOPES="openid profile email"

# OIDC endpoints
KEYCLOAK_AUTHORIZATION_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/logout
KEYCLOAK_USERINFO_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/userinfo

# JWT verification
KEYCLOAK_JWKS_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/certs
JWT_EXPECTED_AUDIENCE=blih-system-api
JWT_EXPECTED_ISSUER=https://keycloak.blihmarketing.com/realms/blih

# Browser auth cookie configuration
# kc_access is the primary authentication artifact.
# kc_refresh is refresh-only and must rotate after successful refresh.
# kc_id is optional identity/logout support and must never authorize requests.
AUTH_FRONTEND_BASE_URL=https://project-k22it.vercel.app
AUTH_ALLOWED_REDIRECT_PATH_PREFIXES=/,/auth,/dashboard,/no-access
AUTH_LOGIN_ERROR_REDIRECT_URI=/auth/signin
AUTH_POST_LOGIN_REDIRECT_URI=/
AUTH_POST_LOGOUT_REDIRECT_URI=/auth/signin
AUTH_STATE_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_RATE_LIMIT_POINTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# PKCE
AUTH_PKCE_ENABLED=true
AUTH_PKCE_METHOD=S256

# OIDC nonce validation
AUTH_NONCE_ENABLED=true

# JWKS cache
JWKS_CACHE_TTL_SECONDS=3600
JWKS_CACHE_MAX_KEYS=5

# -----------------------------------------------------------------------------
# Docker Keycloak container (only if running Keycloak via Docker)
# -----------------------------------------------------------------------------
# KEYCLOAK_PORT=127.0.0.1:8080
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=admin1234
KEYCLOAK_ADMIN=admin-main
KEYCLOAK_ADMIN_PASSWORD=amdeasme7@gmail.com

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=noreply@blih.local
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM="BLIH System <noreply@blih.local>"

# =============================================================================
# Security & Rate Limiting
# =============================================================================
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# =============================================================================
# Audit & Logging Configuration
# =============================================================================
AUDIT_RETENTION_DAYS=2555
PRINCIPAL_CONTEXT_TTL_MS=30000
SYNC_ROLES_FROM_KEYCLOAK=false
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Background Jobs Configuration
# =============================================================================
SYNC_USERS_CRON="0 */30 * * * *"
SYNC_ROLES_CRON="0 0 */2 * * *"
ROTATE_SECRETS_CRON="0 0 1 * * *"
CLEANUP_AUDIT_CRON="0 0 2 * * *"

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=5000
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=8
HEALTH_CHECK_SLEEP_SECONDS=5
API_HEALTH_PATH=api/v1/health
KEYCLOAK_HEALTH_REALM=master

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# =============================================================================
# WebSocket Configuration
# =============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001
WEBSOCKET_PATH=/socket.io

# =============================================================================
# Development & Debugging
# =============================================================================
DEBUG=false
LOG_REQUESTS=true
PERFORMANCE_MONITORING=true

# =============================================================================
# Production Deployment Configuration
# =============================================================================

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=admin1234

# =============================================================================
# Resource Limits Configuration
# =============================================================================
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=1.0
KEYCLOAK_MEMORY_LIMIT=1g
KEYCLOAK_CPU_LIMIT=0.5
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=0.5

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=5000
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=8
HEALTH_CHECK_SLEEP_SECONDS=5
API_HEALTH_PATH=api/v1/health
KEYCLOAK_HEALTH_REALM=master

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
