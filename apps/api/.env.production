# =============================================================================

# BLIH System Core - Environment Configuration

# =============================================================================

# =============================================================================

# Application Configuration

# =============================================================================

NODE_ENV=production
API_HOST=0.0.0.0
PORT=5000
API_PREFIX=api/v1

CORS_ORIGIN=https://project-k22it.vercel.app,https://blihapi.blihmarketing.com,http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true

# =============================================================================

# Database Configuration

# =============================================================================

POSTGRES_USER=postgres
POSTGRES_DB=blih-system
POSTGRES_PASSWORD=admin1234

DATABASE_URL=postgresql://postgres:admin1234@89.116.22.36:5433/blih-system
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=300000
SKIP_DATABASE_CONNECT=false

# =============================================================================

# Keycloak - Core Settings

# =============================================================================

KEYCLOAK_ENABLED=true
KEYCLOAK_URL=https://keycloak.blihmarketing.com
KEYCLOAK_REALM=blih

# -----------------------------------------------------------------------------

# Keycloak Clients

# -----------------------------------------------------------------------------

# Resource server client (API token validation)

API_IMAGE=ghcr.io/blih-tech/blih-api-runtime:b635fbad396a70cec1a2ea74115f5975e078db18
API_MIGRATOR_IMAGE=ghcr.io/blih-tech/blih-api-migrator:b635fbad396a70cec1a2ea74115f5975e078db18
KEYCLOAK_IMAGE=ghcr.io/blih-tech/blih-keycloak:b635fbad396a70cec1a2ea74115f5975e078db18

KEYCLOAK_CLIENT_ID=blih-system-api
KEYCLOAK_CLIENT_SECRET=my-blih-api-secret-2026

# Authentication client (OIDC login)

KEYCLOAK_AUTH_CLIENT_ID=blih-system-auth
KEYCLOAK_AUTH_CLIENT_SECRET=my-blih-auth-secret-2026
# Must be the Nest API /api/v1/auth/callback URL (same host as GET /auth/login), not the Next.js site.
KEYCLOAK_AUTH_REDIRECT_URI=https://blihapi.blihmarketing.com/api/v1/auth/callback
KEYCLOAK_AUTH_SCOPES="openid profile email"

# -----------------------------------------------------------------------------

# Keycloak OIDC Endpoints

# -----------------------------------------------------------------------------

KEYCLOAK_AUTHORIZATION_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/logout
KEYCLOAK_USERINFO_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/userinfo
KEYCLOAK_JWKS_URL=https://keycloak.blihmarketing.com/realms/blih/protocol/openid-connect/certs

JWT_EXPECTED_AUDIENCE=blih-system-api
JWT_EXPECTED_ISSUER=https://keycloak.blihmarketing.com/realms/blih

# -----------------------------------------------------------------------------

# Keycloak Container / Hostname Settings

# -----------------------------------------------------------------------------

KC_HOSTNAME=keycloak.blihmarketing.com
KC_HOSTNAME_URL=https://keycloak.blihmarketing.com
KC_HOSTNAME_ADMIN_URL=https://keycloak.blihmarketing.com
KC_FRONTEND_URL=https://keycloak.blihmarketing.com
KC_HTTPS_ENABLED=true

# -----------------------------------------------------------------------------

# Keycloak Database (if running Keycloak in Docker)

# -----------------------------------------------------------------------------

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=admin1234

# Bootstrap admin (only used on first container startup)

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================

# Authentication Redirect & Cookie Behavior

# =============================================================================

AUTH_FRONTEND_BASE_URL=https://project-k22it.vercel.app
AUTH_ALLOWED_REDIRECT_ORIGINS=https://project-k22it.vercel.app,http://localhost:3000,http://localhost:3001
AUTH_ALLOWED_REDIRECT_PATH_PREFIXES=/,/auth,/no-access,/hr,/finance,/crm,/brain,/pm,/superadmin

AUTH_LOGIN_ERROR_REDIRECT_URI=/
AUTH_POST_LOGIN_REDIRECT_URI=/
AUTH_POST_LOGOUT_REDIRECT_URI=/

AUTH_STATE_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=lax

AUTH_LOGIN_RATE_LIMIT_POINTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================

# OIDC Security Features

# =============================================================================

AUTH_PKCE_ENABLED=true
AUTH_PKCE_METHOD=S256
AUTH_NONCE_ENABLED=true

JWKS_CACHE_TTL_SECONDS=3600
JWKS_CACHE_MAX_KEYS=5

# =============================================================================

# Email Configuration (SMTP)

# =============================================================================

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=noreply@blih.local
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM="BLIH System <noreply@blih.local>"

# =============================================================================

# Security & Rate Limiting

# =============================================================================

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# =============================================================================

# Logging & Auditing

# =============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUESTS=true

AUDIT_RETENTION_DAYS=2555
PRINCIPAL_CONTEXT_TTL_MS=30000
SYNC_ROLES_FROM_KEYCLOAK=false

# =============================================================================

# Background Jobs

# =============================================================================

SYNC_USERS_CRON="0 */30 * * * *"
SYNC_ROLES_CRON="0 0 */2 * * *"
ROTATE_SECRETS_CRON="0 0 1 * * *"
CLEANUP_AUDIT_CRON="0 0 2 * * *"

# =============================================================================

# Health Checks

# =============================================================================

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=5000
HEALTH_CHECK_INTERVAL=15s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=8
HEALTH_CHECK_SLEEP_SECONDS=5

API_HEALTH_PATH=api/v1/health
KEYCLOAK_HEALTH_REALM=master
API_PORT=5000
KEYCLOAK_PORT=8180

# =============================================================================

# WebSocket Configuration

# =============================================================================

WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001
WEBSOCKET_PATH=/socket.io

# =============================================================================

# Resource Limits (Docker)

# =============================================================================

POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=1.0

KEYCLOAK_MEMORY_LIMIT=1g
KEYCLOAK_CPU_LIMIT=0.5

API_MEMORY_LIMIT=1g
API_CPU_LIMIT=0.5

# =============================================================================

# Debug & Performance

# =============================================================================

DEBUG=false
PERFORMANCE_MONITORING=true

# =============================================================================
# Additional Configuration (Required by Code)
# =============================================================================
TRUST_PROXY_PRINCIPAL_HEADERS=false
INTERNAL_AUTH_SHARED_SECRET=
ENFORCE_MFA_FOR_PRIVILEGED=false
AUTH_POLICY_VERSION=1.0
VERBOSE_REQUEST_LOGGING=false
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
RAG_SERVICE_URL=http://localhost:3005
