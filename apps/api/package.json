{
  "name": "blih-system-backend",
  "version": "0.0.1",
  "description": "BLIH System API - Brain & RAG Services",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/src/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "validate:rbac-catalog": "node validate-permission-constants.mjs",
    "lint:check": "npm run validate:rbac-catalog && npm run lint",
    "check-types": "npm run prisma:generate && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "typecheck:full": "npm run prisma:generate && tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "validate:commits": "commitlint --from HEAD~1 --to HEAD --verbose",
    "validate:commits:branch": "commitlint --from main --to HEAD --verbose",
    "verify": "npm run lint:check && npm run typecheck && npm run test -- --ci --passWithNoTests",
    "prisma:generate": "npm run build --workspace @repo/database",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @repo/database",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @repo/database",
    "prisma:brain:validate": "npm run prisma:validate --workspace @repo/database",
    "prisma:brain:format": "npm run prisma:format --workspace @repo/database",
    "prisma:seed": "npm run prisma:seed --workspace @repo/database",
    "db:start": "docker-compose -f docker-compose.local.yml up -d",
    "db:stop": "docker-compose -f docker-compose.local.yml down",
    "db:restart": "npm run db:stop && npm run db:start",
    "db:status": "docker compose -f docker-compose.yml ps",
    "db:logs": "docker compose -f docker-compose.yml logs -f",
    "db:reset": "docker compose -f docker-compose.yml down -v && docker compose -f docker-compose.yml up -d",
    "db:psql": "docker exec -it blih-postgres psql -U postgres -d blih-system-dev"
  },
  "dependencies": {
    "@repo/database": "*",
    "@repo/types": "*",
    "@keycloak/keycloak-admin-client": "^26.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.1.13",
    "@prisma/client": "7.4.1",
    "axios": "^1.13.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jose": "^6.1.2",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "rate-limiter-flexible": "^9.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@repo/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@repo/database/prisma-adapter$": "<rootDir>/platform/prisma/prisma.adapter.jest.ts",
      "^@repo/database/prisma-client$": "<rootDir>/platform/prisma/prisma-client.jest.ts",
      "^@repo/database/generated/enums$": "<rootDir>/../../../packages/database/src/generated/enums.ts"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.*\\.mjs$|@prisma/adapter-pg|@prisma/client|jose))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
