{
  "id": "blih",
  "realm": "blih",
  "enabled": true,
  "displayName": "BLIH System",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "blih-system-auth",
      "name": "BLIH System Auth Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "my-blih-auth-secret-2026",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5000/api/v1/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "audience-blih-api"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "blih-system-api",
      "name": "BLIH System API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "my-blih-api-secret-2026",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "blih-system-frontend",
      "name": "BLIH System Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://project-k22it.vercel.app/*",
        "https://project-k22it.vercel.app/api/auth/callback/keycloak",
        "http://localhost:3000/*",
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "https://project-k22it.vercel.app",
        "http://localhost:3000"
      ],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
