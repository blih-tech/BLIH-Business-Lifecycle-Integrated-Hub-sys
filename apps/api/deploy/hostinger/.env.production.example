# =============================================================================
# BLIH API + Keycloak production runtime example
# Copy to .env.production on the Hostinger VPS and fill real values.
# =============================================================================

# -----------------------------------------------------------------------------
# API runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
API_HOST=0.0.0.0
PORT=5000
API_PREFIX=api/v1
API_PORT=5000
API_HEALTH_PATH=api/v1/health
CORS_ORIGIN=https://your-frontend-domain.example
SWAGGER_ENABLED=false

# Core data and auth
DATABASE_URL=postgresql://app_user:replace_me@postgres-host:5432/blih-system-prod
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=300000
KEYCLOAK_ENABLED=true
KEYCLOAK_REALM=blih
KEYCLOAK_CLIENT_ID=blih-system-api
KEYCLOAK_CLIENT_SECRET=replace_me
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace_me
JWT_EXPECTED_AUDIENCE=blih-system-api
JWT_EXPECTED_ISSUER=https://auth.your-domain.example/realms/blih
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/blih/protocol/openid-connect/certs

# Disable broker in this deployment topology
RABBITMQ_ENABLED=false

# Optional SMTP
SMTP_ENABLED=true
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@your-domain.example
SMTP_PASSWORD=replace_me
EMAIL_FROM=BLIH <noreply@your-domain.example>

# -----------------------------------------------------------------------------
# Keycloak runtime
# -----------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_HEALTH_REALM=master
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres-host:5432/keycloak
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=replace_me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace_me
KC_HOSTNAME=auth.your-domain.example
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=true
KC_PROXY_HEADERS=xforwarded

# Internal URLs consumed by compose/runtime
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_INTERNAL_JWKS_URL=http://keycloak:8080/realms/blih/protocol/openid-connect/certs
