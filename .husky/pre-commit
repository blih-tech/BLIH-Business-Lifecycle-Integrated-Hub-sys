#!/usr/bin/env sh
set -e

echo "🔍 Running lint-staged checks..."

# Disable lint-staged's automatic git backup/restore to avoid
# failing with 'fatal: Needed a single revision' on Windows/PowerShell
LINT_STAGED_DISABLE_BACKUP=true npx lint-staged --concurrent 1 --max-arg-length 3000

echo "✅ Pre-commit checks passed"