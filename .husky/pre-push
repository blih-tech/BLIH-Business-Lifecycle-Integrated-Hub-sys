#!/usr/bin/env sh
set -e

REFS_FILE="$(mktemp)"
cat > "$REFS_FILE"

cleanup() {
  rm -f "$REFS_FILE"
}

trap cleanup EXIT INT TERM

echo "Running pre-push validations..."
node validate-pre-push.js "$@" < "$REFS_FILE"

echo "Running type checks..."
npm run check-types

echo "Running lint..."
npm run lint

echo "Pre-push checks passed."
