#!/usr/bin/env sh
set -e

REFS_FILE="$(mktemp)"
cat > "$REFS_FILE"

cleanup() {
  rm -f "$REFS_FILE"
}

trap cleanup EXIT INT TERM

node apps/api/scripts/git/validate-pre-push.js "$@" < "$REFS_FILE"

node apps/api/scripts/git/run-affected-workspace-checks.js --mode pre-push --refs-file "$REFS_FILE"
