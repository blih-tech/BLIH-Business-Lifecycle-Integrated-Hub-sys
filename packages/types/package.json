{
  "name": "@blih/types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts"
    },
    "./auth/*": {
      "types": "./dist/auth/*.d.ts"
    },
    "./users": {
      "types": "./dist/users/index.d.ts"
    },
    "./users/*": {
      "types": "./dist/users/*.d.ts"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts"
    },
    "./audit/*": {
      "types": "./dist/audit/*.d.ts"
    },
    "./system-config": {
      "types": "./dist/system-config/index.d.ts"
    },
    "./system-config/*": {
      "types": "./dist/system-config/*.d.ts"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts"
    },
    "./rbac/*": {
      "types": "./dist/rbac/*.d.ts"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts"
    },
    "./notifications/*": {
      "types": "./dist/notifications/*.d.ts"
    },
    "./departments": {
      "types": "./dist/departments/index.d.ts"
    },
    "./departments/*": {
      "types": "./dist/departments/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "file:../eslint-config",
    "@repo/typescript-config": "file:../typescript-config",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
