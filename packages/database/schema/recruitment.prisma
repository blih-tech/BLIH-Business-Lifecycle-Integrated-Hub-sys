// Recruitment Models
// Simplified recruitment flow: Job -> Applicant -> Interview/HiringDecision

// Job workflow: DRAFT -> PENDING_FOR_APPROVAL -> READY_TO_POST -> PUBLISHED -> CLOSED (or REJECTED on rejection)
model Job {
  id                    String                 @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String                 @unique
  departmentId          String                 @map("department_id") @db.Uuid
  department            Department             @relation(fields: [departmentId], references: [id])
  positionId            String                 @map("position_id") @db.Uuid
  position              Position               @relation(fields: [positionId], references: [id])
  description           Json                   @db.JsonB
  summary               Json?                  @db.JsonB
  experienceLevel       ExperienceLevel?       @map("experience_level")
  contractType          JobContractType        @map("contract_type")
  employmentType        EmploymentType?        @map("employment_type")
  workLocationType      WorkLocationType       @map("work_location_type")
  remoteScope           RemoteScope?           @map("remote_scope")
  city                  String?                @db.VarChar(128)
  country               String?                @db.VarChar(128)
  openings              Int                    @default(1)
  salaryMin             Decimal?               @map("salary_min") @db.Decimal(12, 2)
  salaryMax             Decimal?               @map("salary_max") @db.Decimal(12, 2)
  currency              String?                @db.VarChar(8)
  salaryMode            JobSalaryMode          @default(NOT_SPECIFIED) @map("salary_mode")
  benefits              String[]               @default([])
  requiredSkills        String[]               @default([]) @map("required_skills")
  preferredSkills       String[]               @default([]) @map("preferred_skills")
  responsibilities      String[]               @default([])
  status                JobWorkflowStatus      @default(DRAFT)
  priority              JobPriority            @default(MEDIUM)
  financeApprovalStatus JobStageApprovalStatus @default(PENDING_FOR_APPROVAL) @map("finance_approval_status")
  gmApprovalStatus      JobStageApprovalStatus @default(PENDING_FOR_APPROVAL) @map("gm_approval_status")
  hrApprovalStatus      JobStageApprovalStatus @default(PENDING_FOR_APPROVAL) @map("hr_approval_status")
  creatorIsHr           Boolean                @default(false) @map("creator_is_hr")
  hiringManagerId       String?                @map("hiring_manager_id") @db.Uuid
  hiringManager         User?                  @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  applicationDeadline   DateTime?              @map("application_deadline")
  draftedAt             DateTime?              @map("drafted_at")
  pendingApprovalAt     DateTime?              @map("pending_approval_at")
  readyToPostAt         DateTime?              @map("ready_to_post_at")
  publishedAt           DateTime?              @map("published_at")
  closedAt              DateTime?              @map("closed_at")
  rejectedAt            DateTime?              @map("rejected_at")
  closingReason         String?                @map("closing_reason") @db.Text
  viewsCount            Int                    @default(0) @map("views_count")
  applicationsCount     Int                    @default(0) @map("applications_count")
  shortlistedCount      Int                    @default(0) @map("shortlisted_count")
  interviewsCount       Int                    @default(0) @map("interviews_count")
  offersCount           Int                    @default(0) @map("offers_count")
  hiresCount            Int                    @default(0) @map("hires_count")
  createdById           String?                @map("created_by_id") @db.Uuid
  createdBy             User?                  @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  approvals             JobApproval[]
  tools                 JobTool[]
  applicants            Applicant[]
  interviews            Interview[]
  hiringDecisions       HiringDecision[]
  requestForm           JobRequestForm?

  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([createdById])
  @@index([financeApprovalStatus])
  @@index([gmApprovalStatus])
  @@index([hrApprovalStatus])
  @@index([hiringManagerId])
}

model JobRequestForm {
  id                    String           @id @default(uuid()) @db.Uuid
  jobId                 String           @unique @map("job_id") @db.Uuid
  job                   Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobTitle              String           @map("job_title")
  departmentId          String           @map("department_id") @db.Uuid
  department            Department       @relation("JobRequestDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  requestedBy           String           @map("requested_by") @db.VarChar(255)
  positionId            String           @map("position_id") @db.Uuid
  position              Position         @relation("JobRequestPosition", fields: [positionId], references: [id], onDelete: Restrict)
  requestType           JobRequestType   @map("request_type")
  replaceForUserId      String?          @map("replace_for_user_id") @db.Uuid
  replaceForUser        User?            @relation("JobRequestReplacementUser", fields: [replaceForUserId], references: [id], onDelete: SetNull)
  businessJustification String           @map("business_justification") @db.Text
  employmentType        EmploymentType   @map("employment_type")
  workMode              WorkLocationType @map("work_mode")
  urgency               JobUrgency
  neededByDate          DateTime         @map("needed_by_date") @db.Date
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  detailsForm           JobDetailsForm?

  @@index([departmentId])
  @@index([positionId])
  @@index([replaceForUserId])
}

model JobDetailsForm {
  id                  String           @id @default(uuid()) @db.Uuid
  requestFormId       String           @unique @map("request_form_id") @db.Uuid
  requestForm         JobRequestForm   @relation(fields: [requestFormId], references: [id], onDelete: Cascade)
  jobTitle            String           @map("job_title")
  location            String           @db.VarChar(255)
  workMode            WorkLocationType @map("work_mode")
  employmentType      EmploymentType   @map("employment_type")
  jobSummary          Json             @map("job_summary") @db.JsonB
  whyJoinUs           Json?            @map("why_join_us") @db.JsonB
  requiredSkills      String[]         @default([]) @map("required_skills")
  responsibilities    String[]         @default([])
  preferredSkills     String[]         @default([]) @map("preferred_skills")
  experienceLevel     ExperienceLevel  @map("experience_level")
  salaryMin           Decimal?         @map("salary_min") @db.Decimal(12, 2)
  salaryMax           Decimal?         @map("salary_max") @db.Decimal(12, 2)
  salaryCurrency      String?          @map("salary_currency") @db.VarChar(8)
  salaryMode          JobSalaryMode    @default(NOT_SPECIFIED) @map("salary_mode")
  benefits            String[]         @default([])
  openings            Int              @default(1)
  applicationDeadline DateTime         @map("application_deadline")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  applicationForm     JobApplicationForm?
}

model JobApplicationForm {
  id               String                         @id @default(uuid()) @db.Uuid
  jobDetailsFormId String                         @unique @map("job_details_form_id") @db.Uuid
  jobDetailsForm   JobDetailsForm                 @relation(fields: [jobDetailsFormId], references: [id], onDelete: Cascade)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  customFields     JobApplicationCustomField[]
  applicants       Applicant[]                    @relation("ApplicantForm")
}

model JobApplicationCustomField {
  id                   String                           @id @default(uuid()) @db.Uuid
  jobApplicationFormId String                           @map("job_application_form_id") @db.Uuid
  jobApplicationForm   JobApplicationForm               @relation(fields: [jobApplicationFormId], references: [id], onDelete: Cascade)
  customFieldId        String                           @map("custom_field_id") @db.VarChar(64)
  label                String                           @db.VarChar(255)
  type                 JobApplicationFieldType
  required             Boolean                          @default(false)
  helpText             String?                          @map("help_text") @db.Text
  order                Int?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  options              JobApplicationCustomFieldOption[]

  @@unique([jobApplicationFormId, customFieldId])
  @@index([jobApplicationFormId])
  @@index([jobApplicationFormId, order])
}

model JobApplicationCustomFieldOption {
  id               String                    @id @default(uuid()) @db.Uuid
  customFieldRowId String                    @map("custom_field_row_id") @db.Uuid
  customField      JobApplicationCustomField @relation(fields: [customFieldRowId], references: [id], onDelete: Cascade)
  value            String                    @db.VarChar(255)
  order            Int
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([customFieldRowId])
  @@index([customFieldRowId, order])
}

model JobApproval {
  id                 String           @id @default(uuid()) @db.Uuid
  jobId              String           @map("job_id") @db.Uuid
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage              JobApprovalStage
  requiredRole       String           @map("required_role") @db.VarChar(64)
  approverId         String?          @map("approver_id") @db.Uuid
  approver           User?            @relation("JobApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decision           ApprovalDecision @default(PENDING)
  autoApproved       Boolean          @default(false) @map("auto_approved")
  autoApprovalReason String?          @map("auto_approval_reason") @db.VarChar(128)
  comments           String?          @db.Text
  decidedAt          DateTime?        @map("decided_at")
  level              Int
  createdAt          DateTime         @default(now())

  @@unique([jobId, stage])
  @@unique([jobId, level])
  @@index([jobId])
  @@index([approverId])
}

model JobTool {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(128)
  category  String?  @db.VarChar(64)
  required  Boolean  @default(true)
  order     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, name])
  @@index([jobId])
  @@index([jobId, order])
}

model Applicant {
  id                String          @id @default(uuid()) @db.Uuid
  jobId             String          @map("job_id") @db.Uuid
  job               Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationFormId String?         @map("application_form_id") @db.Uuid
  applicationForm   JobApplicationForm? @relation("ApplicantForm", fields: [applicationFormId], references: [id], onDelete: SetNull)
  fullName          String          @map("full_name")
  email             String
  emailNormalized   String          @map("email_normalized")
  phone             String?
  resumeUrl         String?         @map("resume_url")
  linkedinUrl       String?         @map("linkedin_url")
  portfolioUrl      String?         @map("portfolio_url")
  githubUrl         String?         @map("github_url")
  source            CandidateSource @default(COMPANY_SITE)
  referredById      String?         @map("referred_by_id") @db.Uuid
  referredBy        User?           @relation("ApplicantReferral", fields: [referredById], references: [id], onDelete: SetNull)
  currentCompany    String?         @map("current_company")
  currentPosition   String?         @map("current_position")
  yearsExperience   Int?            @map("years_experience")
  location          String?
  country           String?
  city              String?
  nationality       String?
  expectedSalary    Decimal?        @map("expected_salary") @db.Decimal(12, 2)
  currentSalary     Decimal?        @map("current_salary") @db.Decimal(12, 2)
  educationLevel    String?         @map("education_level")
  highestDegree     String?         @map("highest_degree")
  skills            String[]        @default([])
  status            ApplicantStatus @default(APPLIED)
  coverLetter       String?         @map("cover_letter") @db.Text
  sourceSnapshot    Json?           @map("source_snapshot") @db.JsonB
  customFieldValues Json?           @map("custom_field_values") @db.JsonB
  appliedAt         DateTime        @default(now()) @map("applied_at")
  shortlistedAt     DateTime?       @map("shortlisted_at")
  interviewAt       DateTime?       @map("interview_at")
  offerAt           DateTime?       @map("offer_at")
  hiredAt           DateTime?       @map("hired_at")
  rejectedAt        DateTime?       @map("rejected_at")
  lastActivityAt    DateTime?       @map("last_activity_at")
  profileScore      Float?          @map("profile_score")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  educations        ApplicantEducation[]
  experiences       ApplicantExperience[]
  interviews        Interview[]
  hiringDecisions   HiringDecision[] @relation("HiringDecisionApplicant")
  statusHistory     ApplicantStatusHistory[]

  @@unique([jobId, emailNormalized])
  @@index([jobId])
  @@index([status])
  @@index([email])
  @@index([emailNormalized])
  @@index([referredById])
}

model ApplicantStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  applicantId String          @map("applicant_id") @db.Uuid
  applicant   Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  changedById String?         @map("changed_by_id") @db.Uuid
  changedBy   User?           @relation("ApplicantStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  fromStatus  ApplicantStatus? @map("from_status")
  toStatus    ApplicantStatus  @map("to_status")
  notes       String?          @db.Text
  changedAt   DateTime         @default(now()) @map("changed_at")
  createdAt   DateTime         @default(now())

  @@index([applicantId])
  @@index([applicantId, changedAt])
  @@index([changedById])
}

model ApplicantEducation {
  id          String    @id @default(uuid()) @db.Uuid
  applicantId String    @map("applicant_id") @db.Uuid
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([applicantId])
}

model ApplicantExperience {
  id          String    @id @default(uuid()) @db.Uuid
  applicantId String    @map("applicant_id") @db.Uuid
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  company     String
  title       String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([applicantId])
}

model Interview {
  id              String          @id @default(uuid()) @db.Uuid
  jobId           String          @map("job_id") @db.Uuid
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId     String          @map("applicant_id") @db.Uuid
  applicant       Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type            InterviewType
  status          InterviewStatus @default(SCHEDULED)
  scheduledAt     DateTime?       @map("scheduled_at")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  durationMinutes Int?            @map("duration_minutes")
  interviewerId   String          @map("interviewer_id") @db.Uuid
  interviewer     User            @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  location        String?         @db.VarChar(255)
  meetingUrl      String?         @map("meeting_url")
  notes           String?         @db.Text
  feedback        Json?           @db.JsonB
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([jobId])
  @@index([applicantId])
  @@index([applicantId, jobId])
  @@index([interviewerId])
  @@index([status])
}

model HiringDecision {
  id                  String               @id @default(uuid()) @db.Uuid
  jobId               String               @map("job_id") @db.Uuid
  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId         String               @map("applicant_id") @db.Uuid
  applicant           Applicant            @relation("HiringDecisionApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  onboardingId        String?              @unique @map("onboarding_id") @db.Uuid
  onboarding          Onboarding?          @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  submittedById       String               @map("submitted_by_id") @db.Uuid
  submittedBy         User                 @relation("HiringDecisionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  outcome             HiringDecisionOutcome @default(OFFER_APPROVED)
  salaryOffered       Decimal?             @map("salary_offered") @db.Decimal(15, 2)
  currency            String?              @db.VarChar(8)
  startDate           DateTime?            @map("start_date") @db.Date
  decisionNotes       String?              @map("decision_notes") @db.Text
  decidedAt           DateTime?            @map("decided_at")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  onboardingChecklists OnboardingChecklist[]

  @@index([jobId])
  @@index([applicantId])
  @@index([onboardingId])
  @@index([submittedById])
}
