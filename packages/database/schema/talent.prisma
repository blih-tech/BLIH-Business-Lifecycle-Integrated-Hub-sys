// Talent and career development models
// This file contains succession planning, promotions, development plans, transfer requests, and salary adjustments

model SuccessionPlan {
  id                  String              @id @default(uuid()) @db.Uuid
  positionId          String              @map("position_id") @db.Uuid
  position            Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateEmployeeId String              @map("candidate_employee_id") @db.Uuid
  candidateEmployee   Employee            @relation("SuccessionCandidateEmployee", fields: [candidateEmployeeId], references: [id], onDelete: Cascade)
  readiness           SuccessionReadiness
  riskLevel           SuccessionRiskLevel @map("risk_level")
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([positionId, candidateEmployeeId])
  @@index([positionId])
  @@index([candidateEmployeeId])
  @@index([readiness])
}

model PromotionProposal {
  id             String                  @id @default(uuid()) @db.Uuid
  employeeId     String                  @map("employee_id") @db.Uuid
  employee       Employee                @relation("PromotionProposalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  fromPositionId String?                 @map("from_position_id") @db.Uuid
  fromPosition   Position?               @relation("PromotionProposalFromPosition", fields: [fromPositionId], references: [id], onDelete: SetNull)
  toPositionId   String?                 @map("to_position_id") @db.Uuid
  toPosition     Position?               @relation("PromotionProposalToPosition", fields: [toPositionId], references: [id], onDelete: SetNull)
  proposedById   String                  @map("proposed_by_id") @db.Uuid
  proposedBy     User                    @relation("PromotionProposalProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  justification  Json?                   @db.JsonB
  status         PromotionProposalStatus @default(PENDING)
  approvedById   String?                 @map("approved_by_id") @db.Uuid
  approvedBy     User?                   @relation("PromotionProposalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?               @map("approved_at")
  rejectedAt     DateTime?               @map("rejected_at")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([employeeId])
  @@index([fromPositionId])
  @@index([toPositionId])
  @@index([proposedById])
  @@index([approvedById])
  @@index([status])
}

model CareerDevelopmentPlan {
  id                 String                      @id @default(uuid()) @db.Uuid
  employeeId         String                      @map("employee_id") @db.Uuid
  employee           Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentPositionId  String?                     @map("current_position_id") @db.Uuid
  currentPosition    Position?                   @relation("CareerPlanCurrentPosition", fields: [currentPositionId], references: [id], onDelete: SetNull)
  targetPositionId   String?                     @map("target_position_id") @db.Uuid
  targetPosition     Position?                   @relation("CareerPlanTargetPosition", fields: [targetPositionId], references: [id], onDelete: SetNull)
  planYear           Int                         @map("plan_year")
  title              String                      @db.VarChar(255)
  summary            String?                     @db.Text
  goals              Json                        @db.JsonB
  developmentActions Json?                       @map("development_actions") @db.JsonB
  successMetrics     Json?                       @map("success_metrics") @db.JsonB
  progressPercent    Int                         @default(0) @map("progress_percent")
  lastProgressAt     DateTime?                   @map("last_progress_at")
  completedAt        DateTime?                   @map("completed_at")
  status             CareerDevelopmentPlanStatus @default(DRAFT)
  createdById        String                      @map("created_by_id") @db.Uuid
  createdBy          User                        @relation("CareerPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([employeeId])
  @@index([currentPositionId])
  @@index([targetPositionId])
  @@index([planYear])
  @@index([status])
  @@index([createdById])
}

model TrainingNeedsAssessment {
  id                 String                @id @default(uuid()) @db.Uuid
  employeeId         String                @map("employee_id") @db.Uuid
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basedOnReviewId    String?               @map("based_on_review_id") @db.Uuid
  basedOnReview      PerformanceReview?    @relation(fields: [basedOnReviewId], references: [id], onDelete: SetNull)
  periodYear         Int                   @map("period_year")
  assessedById       String                @map("assessed_by_id") @db.Uuid
  assessedBy         User                  @relation("TrainingNeedsAssessmentAssessor", fields: [assessedById], references: [id], onDelete: Restrict)
  developmentAreas   Json                  @map("development_areas") @db.JsonB
  requestedTrainings Json                  @map("requested_trainings") @db.JsonB
  skillGapSummary    String?               @map("skill_gap_summary") @db.Text
  managerNotes       String?               @map("manager_notes") @db.Text
  priority           String?               @db.VarChar(32)
  status             RequestWorkflowStatus @default(DRAFT)
  submittedAt        DateTime?             @map("submitted_at")
  reviewedById       String?               @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?                 @relation("TrainingNeedsAssessmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?             @map("reviewed_at")
  rejectionReason    String?               @map("rejection_reason") @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([employeeId])
  @@index([basedOnReviewId])
  @@index([periodYear])
  @@index([assessedById])
  @@index([reviewedById])
  @@index([status])
}

model InternalTransferRequest {
  id                   String                    @id @default(uuid()) @db.Uuid
  requestId            String                    @unique @map("request_id") @db.VarChar(32)
  employeeId           String                    @map("employee_id") @db.Uuid
  employee             Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType          InternalTransferType      @map("request_type")
  currentPositionId    String?                   @map("current_position_id") @db.Uuid
  currentPosition      Position?                 @relation("InternalTransferCurrentPosition", fields: [currentPositionId], references: [id], onDelete: SetNull)
  targetPositionId     String                    @map("target_position_id") @db.Uuid
  targetPosition       Position                  @relation("InternalTransferTargetPosition", fields: [targetPositionId], references: [id], onDelete: Restrict)
  requestedById        String                    @map("requested_by_id") @db.Uuid
  requestedBy          User                      @relation("InternalTransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reason               String                    @db.Text
  businessCase         Json?                     @map("business_case") @db.JsonB
  desiredEffectiveDate DateTime?                 @map("desired_effective_date") @db.Date
  compensationChange   Json?                     @map("compensation_change") @db.JsonB
  status               RequestWorkflowStatus     @default(DRAFT)
  submittedAt          DateTime?                 @map("submitted_at")
  approvedById         String?                   @map("approved_by_id") @db.Uuid
  approvedBy           User?                     @relation("InternalTransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?                 @map("approved_at")
  rejectionReason      String?                   @map("rejection_reason") @db.Text
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  salaryAdjustments    SalaryAdjustmentRequest[]

  @@index([employeeId])
  @@index([requestType])
  @@index([currentPositionId])
  @@index([targetPositionId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([status])
}

model SalaryAdjustmentRequest {
  id                      String                   @id @default(uuid()) @db.Uuid
  requestId               String                   @unique @map("request_id") @db.VarChar(32)
  employeeId              String                   @map("employee_id") @db.Uuid
  employee                Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  proposedById            String                   @map("proposed_by_id") @db.Uuid
  proposedBy              User                     @relation("SalaryAdjustmentProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  linkedReviewId          String?                  @map("linked_review_id") @db.Uuid
  linkedReview            PerformanceReview?       @relation(fields: [linkedReviewId], references: [id], onDelete: SetNull)
  linkedTransferRequestId String?                  @map("linked_transfer_request_id") @db.Uuid
  linkedTransferRequest   InternalTransferRequest? @relation(fields: [linkedTransferRequestId], references: [id], onDelete: SetNull)
  reason                  SalaryAdjustmentReason
  currentBaseSalary       Decimal?                 @map("current_base_salary") @db.Decimal(15, 2)
  proposedBaseSalary      Decimal                  @map("proposed_base_salary") @db.Decimal(15, 2)
  percentChange           Decimal                  @map("percent_change") @db.Decimal(6, 2)
  currency                String?                  @db.VarChar(3)
  effectiveFrom           DateTime                 @map("effective_from") @db.Date
  justification           Json?                    @db.JsonB
  status                  RequestWorkflowStatus    @default(DRAFT)
  submittedAt             DateTime?                @map("submitted_at")
  approvedById            String?                  @map("approved_by_id") @db.Uuid
  approvedBy              User?                    @relation("SalaryAdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt              DateTime?                @map("approved_at")
  rejectionReason         String?                  @map("rejection_reason") @db.Text
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([employeeId])
  @@index([proposedById])
  @@index([linkedReviewId])
  @@index([linkedTransferRequestId])
  @@index([approvedById])
  @@index([effectiveFrom])
  @@index([status])
}
