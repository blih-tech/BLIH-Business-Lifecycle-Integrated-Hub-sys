// System-level Models
// This file contains AuditLog, Notification, Webhook, Config, and other system models

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  action        String
  module        String
  resource      String
  resourceId    String?
  actorUserId   String?
  actorEmail    String?
  requestId     String
  correlationId String
  sessionId     String?
  ipAddress     String
  userAgent     String
  result        AuditResult @default(SUCCESS)
  statusCode    Int?
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([result, createdAt])
  @@index([actorUserId])
  @@index([action, resource])
}

model AuditExport {
  id          String    @id @default(uuid()) @db.Uuid
  requestedBy String
  format      String
  filters     Json?
  status      String
  filePath    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String?
  type       String
  priority   String
  title      String
  body       String
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  response       Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([notificationId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  url       String
  secret    String?
  enabled   Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ModuleConfig {
  id         String   @id @default(uuid()) @db.Uuid
  module     String   @unique
  enabled    Boolean  @default(true)
  licenseKey String?
  settings   Json?
  updatedAt  DateTime @updatedAt
}

model SecurityPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  requireMfa            Boolean  @default(true)
  maxConcurrentSessions Int      @default(3)
  sessionTimeoutMinutes Int      @default(480)
  passwordMinLength     Int      @default(12)
  lockoutThreshold      Int      @default(5)
  updatedAt             DateTime @updatedAt
}

model WorkSchedule {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String             @unique
  description           String?
  timezone              String?            @db.VarChar(64)
  isDefault             Boolean            @default(false) @map("is_default")
  lateThresholdMinutes  Int                @default(15) @map("late_threshold_minutes")
  standardMinutesPerDay Int                @default(480) @map("standard_minutes_per_day")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assignments           UserWorkSchedule[]
  days                  WorkScheduleDay[]

  @@index([isDefault])
}

model WorkScheduleDay {
  id              String       @id @default(uuid()) @db.Uuid
  scheduleId      String       @map("schedule_id") @db.Uuid
  schedule        WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek       DayOfWeek    @map("day_of_week")
  isWorkingDay    Boolean      @default(true) @map("is_working_day")
  startMinute     Int?         @map("start_minute")
  endMinute       Int?         @map("end_minute")
  expectedMinutes Int?         @map("expected_minutes")
  remoteAllowed   Boolean      @default(false) @map("remote_allowed")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
}

model UserWorkSchedule {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  scheduleId    String       @map("schedule_id") @db.Uuid
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([employeeId])
  @@index([scheduleId])
  @@index([employeeId, effectiveFrom])
}
